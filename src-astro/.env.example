# ─── JWT Auth ─────────────────────────────────────────────────────────────────
# Secret key for signing admin JWT tokens.
# Generate with: openssl rand -hex 32
JWT_SECRET=change-me-to-a-random-secret

# Admin credentials for legacy/dev fallback.
# In production these should be strong, unique values.
AUTH_ADMIN_EMAIL=admin@octavofuego.com
AUTH_ADMIN_PASSWORD=change-me-to-a-strong-password

# ─── L-Medusa Inventory ───────────────────────────────────────────────────────
# Provider: 'mock' | 'supabase' | 'medusa'
PUBLIC_INVENTORY_PROVIDER=mock

# Supabase (when PUBLIC_INVENTORY_PROVIDER=supabase)
PUBLIC_SUPABASE_URL=https://your-project.supabase.co
PUBLIC_SUPABASE_ANON_KEY=eyJ...
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# Stock locations
PUBLIC_LOCATION_BRAZIL=sloc_brazil_factory
PUBLIC_LOCATION_COLOMBIA=sloc_colombia_distribution

# Low stock threshold (grams)
PUBLIC_LOW_STOCK_THRESHOLD=50

# ─── WhatsApp Checkout ────────────────────────────────────────────────────────
# Phone number for WhatsApp orders (include country code, no spaces or +)
PUBLIC_WHATSAPP_PHONE=573101234567

# ─── Payment (eventual) ──────────────────────────────────────────────────────
# When facturing +$50K COP/month, configure Wompi (CO) or Stripe (BR)
PUBLIC_PAYMENT_PROVIDER=wompi

# ─── Medusa (future) ──────────────────────────────────────────────────────────
# When using full Medusa backend, set these:
# MEDUSA_BACKEND_URL=http://localhost:9000
# MEDUSA_API_KEY=medusa_xxx

# ─── IndexNow — Bing/Yandex rapid indexing ────────────────────────────────────
# Generate your own key at https://www.indexnow.org/
INDEXNOW_KEY=8f4a2c1e9d7b3f5a

# ─── Measurement (env-gated, default OFF) ─────────────────────────────────────
# Each snippet ships ZERO bytes to the browser until its env var is set.
# PUBLIC_GSC_VERIFICATION — content value of the google-site-verification meta
# tag. Get it from Google Search Console → Settings → Ownership verification →
# HTML tag, and copy the full content string (e.g. "abc123...xyz").
PUBLIC_GSC_VERIFICATION=
# PUBLIC_CLARITY_ID — Microsoft Clarity project ID. Get it from
# https://clarity.microsoft.com → Projects → Connect → Install with code.
PUBLIC_CLARITY_ID=
# PUBLIC_META_PIXEL_ID — Meta (Facebook) Pixel ID. Get it from
# Meta Events Manager → Data sources → Pixel → Settings.
PUBLIC_META_PIXEL_ID=
