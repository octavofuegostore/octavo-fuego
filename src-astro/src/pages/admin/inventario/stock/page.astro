---
export const prerender = false;
// Stock page — Inventory stock levels by location (datos reales)
import AdminLayout from '@/layouts/AdminLayout.astro';
import { supabase } from '@/lib/supabase';
import { getBodegaSeleccionada } from '@/lib/admin/bodega';

const bodegaId = getBodegaSeleccionada(Astro.cookies);
const { data: niveles } = await supabase
  .from('gramos_disponibles')
  .select('*')
  .order('producto_slug');
const stockData = bodegaId ? (niveles ?? []).filter(n => n.bodega_id === bodegaId) : (niveles ?? []);

// Map to client-friendly format
interface StockItem {
  productId: string;
  productName: string;
  sku: string;
  location: string;
  current: number;
  minimum: number;
}

const stockItems: StockItem[] = (stockData ?? []).map(n => ({
  productId: n.item_id,
  productName: n.producto_slug?.replace(/-/g, ' ').replace(/\b\w/g, c => c.toUpperCase()) ?? 'Sin nombre',
  sku: n.sku ?? '',
  location: n.bodega_codigo ?? n.pais ?? '',
  current: n.gramos_disponibles ?? 0,
  minimum: n.gramos_alerta ?? 50,
}));
---

<AdminLayout title="Stock" description="Niveles de inventario por ubicación">
  <!-- Page Header -->
  <div class="mb-8">
    <h1 class="text-2xl font-display font-bold text-humo">Stock</h1>
    <p class="text-ceniza mt-1">Niveles de inventario por ubicación</p>
  </div>

  <!-- Filter -->
  <div class="mb-6 flex items-center gap-4">
    <div class="flex-1 max-w-xs">
      <div class="relative">
        <svg class="absolute left-3 top-1/2 -translate-y-1/2 w-4 h-4 text-ceniza" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
        </svg>
        <input
          type="text"
          id="search-stock"
          placeholder="Buscar producto..."
          class="w-full pl-10 pr-4 py-2 border border-papel rounded-lg text-sm focus:outline-none focus:ring-2 focus:ring-tabaco/20 focus:border-tabaco transition-colors"
        />
      </div>
    </div>
    <select id="location-filter" class="px-3 py-2 border border-papel rounded-lg text-sm focus:outline-none focus:ring-2 focus:ring-tabaco/20 focus:border-tabaco">
      <option value="">Todas las ubicaciones</option>
      <option value="CO">CO-BOGOTA</option>
      <option value="BR">BR-ACRE</option>
    </select>
    <select id="status-filter" class="px-3 py-2 border border-papel rounded-lg text-sm focus:outline-none focus:ring-2 focus:ring-tabaco/20 focus:border-tabaco">
      <option value="">Todos los estados</option>
      <option value="ok">Normal</option>
      <option value="low">Stock Bajo</option>
      <option value="critical">Crítico</option>
    </select>
  </div>

  <!-- Stock Table -->
  <div class="bg-white rounded-2xl shadow-card overflow-hidden">
    <div class="overflow-x-auto">
      <table class="w-full">
        <thead>
          <tr class="border-b border-papel">
            <th class="text-left px-6 py-3 text-xs font-medium text-ceniza uppercase tracking-wider">Producto</th>
            <th class="text-center px-6 py-3 text-xs font-medium text-ceniza uppercase tracking-wider">Ubicación</th>
            <th class="text-right px-6 py-3 text-xs font-medium text-ceniza uppercase tracking-wider">Stock Actual</th>
            <th class="text-right px-6 py-3 text-xs font-medium text-ceniza uppercase tracking-wider">Stock Mínimo</th>
            <th class="text-center px-6 py-3 text-xs font-medium text-ceniza uppercase tracking-wider">Estado</th>
            <th class="text-right px-6 py-3 text-xs font-medium text-ceniza uppercase tracking-wider">Acciones</th>
          </tr>
        </thead>
        <tbody id="stock-tbody" class="divide-y divide-papel">
          <!-- JS will populate this -->
        </tbody>
      </table>
    </div>
  </div>
</AdminLayout>

<script define:vars={{ stockItems }}>
  import { toast } from 'sonner';

  function initPage() {
    let filteredStock = [...(stockItems as Array<{ productId: string; productName: string; sku: string; location: string; current: number; minimum: number }>)];

    const searchInput = document.getElementById('search-stock') as HTMLInputElement;
    const locationFilter = document.getElementById('location-filter') as HTMLSelectElement;
    const statusFilter = document.getElementById('status-filter') as HTMLSelectElement;

    function getStatus(current: number, minimum: number): { class: string; label: string } {
      if (current < minimum * 0.5) return { class: 'bg-error/10 text-error', label: 'Crítico' };
      if (current < minimum) return { class: 'bg-warning/10 text-warning', label: 'Stock Bajo' };
      return { class: 'bg-success/10 text-success', label: 'Normal' };
    }

    function filterStock() {
      const query = searchInput?.value.toLowerCase() || '';
      const location = locationFilter?.value || '';
      const status = statusFilter?.value || '';

      filteredStock = (stockItems as Array<{ productId: string; productName: string; sku: string; location: string; current: number; minimum: number }>).filter(s => {
        const matchesSearch = s.productName.toLowerCase().includes(query) || s.sku.toLowerCase().includes(query);
        const matchesLocation = !location || s.location.startsWith(location);
        const statusInfo = getStatus(s.current, s.minimum);
        const matchesStatus = !status || (status === 'ok' && statusInfo.label === 'Normal') ||
                             (status === 'low' && statusInfo.label === 'Stock Bajo') ||
                             (status === 'critical' && statusInfo.label === 'Crítico');
        return matchesSearch && matchesLocation && matchesStatus;
      });

      renderStock();
    }

    function renderStock() {
      const tbody = document.getElementById('stock-tbody');
      if (!tbody) return;

      // Clear safely
      tbody.textContent = '';

      for (const s of filteredStock) {
        const status = getStatus(s.current, s.minimum);
        const locationBg = s.location.startsWith('CO') ? 'bg-info/10 text-info' : 'bg-success/10 text-success';

        const tr = document.createElement('tr');
        tr.className = 'hover:bg-papel/30 transition-colors';

        // ── Product name + SKU ──
        const td1 = document.createElement('td');
        td1.className = 'px-6 py-4';
        const div1 = document.createElement('div');
        const pName = document.createElement('p');
        pName.className = 'text-sm font-medium text-humo';
        pName.textContent = s.productName;
        const pSku = document.createElement('p');
        pSku.className = 'text-xs text-ceniza';
        pSku.textContent = s.sku;
        div1.appendChild(pName);
        div1.appendChild(pSku);
        td1.appendChild(div1);
        tr.appendChild(td1);

        // ── Location ──
        const td2 = document.createElement('td');
        td2.className = 'px-6 py-4 text-center';
        const spanLoc = document.createElement('span');
        spanLoc.className = `inline-flex items-center px-2 py-0.5 rounded-full text-xs font-medium ${locationBg}`;
        spanLoc.textContent = s.location;
        td2.appendChild(spanLoc);
        tr.appendChild(td2);

        // ── Current stock ──
        const td3 = document.createElement('td');
        td3.className = 'px-6 py-4 text-right text-sm font-medium text-humo';
        td3.textContent = `${s.current}g`;
        tr.appendChild(td3);

        // ── Minimum stock ──
        const td4 = document.createElement('td');
        td4.className = 'px-6 py-4 text-right text-sm text-ceniza';
        td4.textContent = `${s.minimum}g`;
        tr.appendChild(td4);

        // ── Status badge ──
        const td5 = document.createElement('td');
        td5.className = 'px-6 py-4 text-center';
        const spanStatus = document.createElement('span');
        spanStatus.className = `inline-flex items-center px-2 py-0.5 rounded-full text-xs font-medium ${status.class}`;
        spanStatus.textContent = status.label;
        td5.appendChild(spanStatus);
        tr.appendChild(td5);

        // ── Actions ──
        const td6 = document.createElement('td');
        td6.className = 'px-6 py-4 text-right';
        const btn = document.createElement('button');
        btn.className = 'p-1.5 text-ceniza hover:text-tabaco hover:bg-tabaco/10 rounded-lg transition-colors';
        btn.title = 'Ajustar stock';
        btn.innerHTML = '<svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6V4m0 2a2 2 0 100 4m0-4a2 2 0 110 4m-6 8a2 2 0 100-4m0 4a2 2 0 110-4m0 4v2m0-6V4m6 6v10m6-2a2 2 0 100-4m0 4a2 2 0 110-4m0 4v2m0-6V4" /></svg>';
        td6.appendChild(btn);
        tr.appendChild(td6);

        tbody.appendChild(tr);
      }
    }

    searchInput?.addEventListener('input', filterStock);
    locationFilter?.addEventListener('change', filterStock);
    statusFilter?.addEventListener('change', filterStock);

    renderStock();
  }

  initPage();
  document.addEventListener('astro:page-load', initPage);
</script>
