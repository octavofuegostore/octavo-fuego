---
export const prerender = false;
// Dashboard page — Admin Panel home
import AdminLayout from '@/layouts/AdminLayout.astro';
import StatsCard from '@/components/admin/dashboard/StatsCard.astro';
import RecentOrders from '@/components/admin/dashboard/RecentOrders.astro';
import LowStock from '@/components/admin/dashboard/LowStock.astro';
import GraficaLíneas from '@/components/admin/contabilidad/GraficaLíneas.astro';
import GraficaTorta from '@/components/admin/charts/GraficaTorta.astro';
import GraficaBarrasH from '@/components/admin/charts/GraficaBarrasH.astro';
import { crearServicios } from '@/lib/admin/provider';
import { formatCurrency } from '@/lib/formatCurrency';
import { getBodegaSeleccionada } from '@/lib/admin/bodega';
import {
  computeOrdenesPorEstado,
  computeTendenciaIngresos,
  computeTopProductos,
} from '@/lib/admin/dashboard/chart-data';

// Compute real stats from service layer (falls back to mock when no Supabase)
const bodegaId = getBodegaSeleccionada(Astro.cookies);
const svc = crearServicios(bodegaId);
let ordenes = [], clientes = [], productos = [];
try {
  const results = await Promise.all([
    svc.ordenes.listar({ limit: 100 }),
    svc.clientes.listar({ limit: 100 }),
    svc.productos.listar({ limit: 50 }),
  ]);
  ordenes = results[0] ?? [];
  clientes = results[1] ?? [];
  productos = results[2] ?? [];
} catch {
  // One or more services failed — render dashboard with empty data
  ordenes = [];
  clientes = [];
  productos = [];
}

// Stats (period-independent — show current state)
const ventasHoy = ordenes
  .filter(o => o.status !== 'cancelada')
  .reduce((sum, o) => sum + o.total, 0);

const ordenesActivas = ordenes.filter(
  o => o.status === 'pendiente' || o.status === 'confirmada'
).length;

const totalProductos = productos.filter(p => p.status !== 'inactivo').length;
const totalClientesActivos = clientes.filter(c => c.status === 'activo').length;

// SSR initial chart data (default period = mes)
// On period change, client JS fetches /api/admin/dashboard?periodo=...
const defaultPeriod = 'mes';
const revenueData = computeTendenciaIngresos(ordenes, defaultPeriod)
const ordersData = computeOrdenesPorEstado(ordenes, defaultPeriod)
const productsData = computeTopProductos(ordenes, defaultPeriod)

// Torta colors (must match client-side)
const STATIC_TORTA_COLORS = ['#8B4513', '#C4956A', '#5A4D3F', '#3D2E22', '#6D5E4D', '#A0845C', '#E8D5B7'];
const ordersDataWithColors = ordersData.map((d, i) => ({ ...d, color: STATIC_TORTA_COLORS[i % STATIC_TORTA_COLORS.length] }));
---

<AdminLayout title="Dashboard" description="Panel de administración de Octavo Fuego">
  <!-- Content State (visible immediately — no artificial loading) -->
  <div id="dashboard-content">
    <!-- Page Header -->
    <div class="mb-8 flex items-center justify-between">
      <div>
        <h1 class="text-2xl font-display font-bold text-humo">Dashboard</h1>
        <p class="text-ceniza mt-1">Resumen de tu negocio</p>
      </div>
      <!-- Period Selector -->
      <div class="flex items-center gap-2">
        <label for="period-selector" class="text-sm text-ceniza">Periodo:</label>
        <select
          id="period-selector"
          class="px-3 py-2 border border-papel rounded-lg text-sm focus:outline-none focus:ring-2 focus:ring-tabaco/20 focus:border-tabaco bg-white"
        >
          <option value="1m">Mes</option>
          <option value="3m">Trimestre</option>
          <option value="12m">Año</option>
        </select>
      </div>
    </div>

    <!-- Charts Section (dynamically updated by period selector JS) -->
    <div class="mb-8 space-y-6">
      <!-- Top Row: Line Chart + Donut Chart -->
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-6">
        <div id="chart-revenue" data-chart="revenue">
          <GraficaLíneas
            data={revenueData}
            title="Tendencia de Ingresos (Mes)"
            height={220}
            color="#8B4513"
            fillColor="rgba(139,69,51,0.1)"
          />
        </div>

        <div id="chart-orders" data-chart="orders">
          <GraficaTorta
            data={ordersDataWithColors}
            title="Órdenes por Estado (Mes)"
            size={280}
          />
        </div>
      </div>

      <!-- Bottom Row: Top Products -->
      <div id="chart-products" data-chart="products">
        <GraficaBarrasH
          data={productsData}
          title="Top 5 Productos (Mes)"
          barHeight={32}
          barGap={10}
        />
      </div>
    </div>

    <!-- Stats Grid -->
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6 mb-8">
      <StatsCard
        title="Ventas Hoy"
        value={formatCurrency(ventasHoy, 'COP')}
        change={12.5}
        trend="up"
        icon='<svg class="w-6 h-6 text-[var(--color-action-primary)]" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8c-1.657 0-3 .895-3 2s1.343 2 3 2 3 .895 3 2-1.343 2-3 2m0-8c1.11 0 2.08.402 2.599 1M12 8V7m0 1v8m0 0v1m0-1c-1.11 0-2.08-.402-2.599-1M21 12a9 9 0 11-18 0 9 9 0 0118 0z" /></svg>'
      />

      <StatsCard
        title="Órdenes Activas"
        value={String(ordenesActivas)}
        change={8.3}
        trend="up"
        icon='<svg class="w-6 h-6 text-[var(--color-action-primary)]" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 11V7a4 4 0 00-8 0v4M5 9h14l1 12H4L5 9z" /></svg>'
      />

      <StatsCard
        title="Productos"
        value={String(totalProductos)}
        change={4}
        trend="up"
        icon='<svg class="w-6 h-6 text-[var(--color-action-primary)]" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M20 7l-8-4-8 4m16 0l-8 4m8-4v10l-8 4m0-10L4 7m8 4v10M4 7v10l8 4" /></svg>'
      />

      <StatsCard
        title="Clientes"
        value={String(totalClientesActivos)}
        change={15}
        trend="up"
        icon='<svg class="w-6 h-6 text-[var(--color-action-primary)]" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4.354a4 4 0 110 5.292M15 21H3v-1a6 6 0 0112 0v1zm0 0h6v-1a6 6 0 00-9-5.197M13 7a4 4 0 11-8 0 4 4 0 018 0z" /></svg>'
      />
    </div>

    <!-- Content Grid -->
    <div class="grid grid-cols-1 lg:grid-cols-3 gap-6">
      <div class="lg:col-span-2">
        <RecentOrders ordenes={ordenes} />
      </div>
      <div>
        <LowStock productos={productos} />
      </div>
    </div>

    <!-- Quick Actions -->
    <div class="mt-8">
      <h2 class="text-lg font-display font-bold text-humo mb-4">Acciones Rápidas</h2>
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4">
        <a href="/admin/inventario" class="flex items-center gap-3 p-4 bg-white rounded-xl shadow-card hover:shadow-hover transition-all duration-300 group">
          <div class="w-10 h-10 bg-tabaco/10 rounded-lg flex items-center justify-center group-hover:bg-tabaco group-hover:text-white transition-colors">
            <svg class="w-5 h-5 text-[var(--color-action-primary)] group-hover:text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M20 7l-8-4-8 4m16 0l-8 4m8-4v10l-8 4m0-10L4 7m8 4v10M4 7v10l8 4" />
            </svg>
          </div>
          <div>
            <p class="font-medium text-humo">Inventario</p>
            <p class="text-xs text-ceniza">Gestionar productos</p>
          </div>
        </a>

        <a href="/admin/ordenes" class="flex items-center gap-3 p-4 bg-white rounded-xl shadow-card hover:shadow-hover transition-all duration-300 group">
          <div class="w-10 h-10 bg-tabaco/10 rounded-lg flex items-center justify-center group-hover:bg-tabaco group-hover:text-white transition-colors">
            <svg class="w-5 h-5 text-[var(--color-action-primary)] group-hover:text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 11V7a4 4 0 00-8 0v4M5 9h14l1 12H4L5 9z" />
            </svg>
          </div>
          <div>
            <p class="font-medium text-humo">Órdenes</p>
            <p class="text-xs text-ceniza">Ver pedidos</p>
          </div>
        </a>

        <a href="/admin/clientes" class="flex items-center gap-3 p-4 bg-white rounded-xl shadow-card hover:shadow-hover transition-all duration-300 group">
          <div class="w-10 h-10 bg-tabaco/10 rounded-lg flex items-center justify-center group-hover:bg-tabaco group-hover:text-white transition-colors">
            <svg class="w-5 h-5 text-[var(--color-action-primary)] group-hover:text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4.354a4 4 0 110 5.292M15 21H3v-1a6 6 0 0112 0v1zm0 0h6v-1a6 6 0 00-9-5.197M13 7a4 4 0 11-8 0 4 4 0 018 0z" />
            </svg>
          </div>
          <div>
            <p class="font-medium text-humo">Clientes</p>
            <p class="text-xs text-ceniza">Ver clientes</p>
          </div>
        </a>

        <a href="/admin/configuracion" class="flex items-center gap-3 p-4 bg-white rounded-xl shadow-card hover:shadow-hover transition-all duration-300 group">
          <div class="w-10 h-10 bg-tabaco/10 rounded-lg flex items-center justify-center group-hover:bg-tabaco group-hover:text-white transition-colors">
            <svg class="w-5 h-5 text-[var(--color-action-primary)] group-hover:text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10.325 4.317c.426-1.756 2.924-1.756 3.35 0a1.724 1.724 0 002.573 1.066c1.543-.94 3.31.826 2.37 2.37a1.724 1.724 0 001.065 2.572c1.756.426 1.756 2.924 0 3.35a1.724 1.724 0 00-1.066 2.573c.94 1.543-.826 3.31-2.37 2.37a1.724 1.724 0 00-2.572 1.065c-.426 1.756-2.924 1.756-3.35 0a1.724 1.724 0 00-2.573-1.066c-1.543.94-3.31-.826-2.37-2.37a1.724 1.724 0 00-1.065-2.572c-1.756-.426-1.756-2.924 0-3.35a1.724 1.724 0 001.066-2.573c-.94-1.543.826-3.31 2.37-2.37.996.608 2.296.07 2.572-1.065z" />
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z" />
            </svg>
          </div>
          <div>
            <p class="font-medium text-humo">Configuración</p>
            <p class="text-xs text-ceniza">Ajustes del sistema</p>
          </div>
        </a>
      </div>
    </div>
  </div>
</AdminLayout>

<script>
  // ─── SVG Chart Renderers (client-side, mirrors Astro components) ────────

  type DataPoint = { label: string; value: number };
  type TortaPoint = DataPoint & { color: string };

  function formatCOP(amount: number): string {
    return new Intl.NumberFormat('es-CO', {
      style: 'currency',
      currency: 'COP',
      maximumFractionDigits: 0,
    }).format(amount);
  }

  function formatShort(val: number): string {
    if (val >= 1_000_000) return (val / 1_000_000).toFixed(1) + 'M';
    if (val >= 1_000) return (val / 1_000).toFixed(0) + 'k';
    return String(val);
  }

  /** Render a line chart SVG string */
  function renderLineChart(
    data: DataPoint[],
    title: string,
    height = 220,
    color = '#8B4513',
    fillColor = 'rgba(139,69,51,0.1)',
  ): string {
    const padding = { top: 20, right: 20, bottom: 40, left: 50 };
    const chartWidth = 500 - padding.left - padding.right;
    const chartHeight = height - padding.top - padding.bottom;
    const maxValue = Math.max(...data.map((d) => d.value), 1) * 1.2;
    const steps = 4;
    const yStep = maxValue / steps;
    const pointSpacing = chartWidth / Math.max(data.length - 1, 1);

    const points = data
      .map((d, i) => {
        const x = padding.left + i * pointSpacing;
        const y = padding.top + chartHeight - (d.value / maxValue) * chartHeight;
        return `${x},${y}`;
      })
      .join(' ');

    const areaPoints = [
      `${padding.left},${padding.top + chartHeight}`,
      points,
      `${padding.left + chartWidth},${padding.top + chartHeight}`,
    ].join(' ');

    // Grid lines + y-labels
    let gridHtml = '';
    for (let i = 0; i <= steps; i++) {
      const y = padding.top + chartHeight - (i * chartHeight) / steps;
      const val = Math.round(yStep * i);
      gridHtml += `<line x1="${padding.left}" y1="${y}" x2="${500 - padding.right}" y2="${y}" stroke="#E5E5E7" stroke-width="1" />`;
      gridHtml += `<text x="${padding.left - 8}" y="${y + 4}" text-anchor="end" fill="#7b8084" font-size="10">${formatShort(val)}</text>`;
    }

    // Circles for data points
    let circlesHtml = '';
    for (let i = 0; i < data.length; i++) {
      if (data[i].value > 0) {
        const x = padding.left + i * pointSpacing;
        const y = padding.top + chartHeight - (data[i].value / maxValue) * chartHeight;
        circlesHtml += `<circle cx="${x}" cy="${y}" r="3" fill="${color}" />`;
      }
    }

    // X-axis labels
    let labelsHtml = '';
    for (let i = 0; i < data.length; i++) {
      const x = padding.left + i * pointSpacing;
      labelsHtml += `<text x="${x}" y="${height - 5}" text-anchor="middle" fill="#7b8084" font-size="10">${escapeXml(data[i].label)}</text>`;
    }

    return `<div class="bg-white rounded-2xl p-6 shadow-card">
      <h3 class="text-base font-display font-bold text-humo mb-4">${escapeXml(title)}</h3>
      <svg viewBox="0 0 500 ${height}" class="w-full h-auto" xmlns="http://www.w3.org/2000/svg">
        ${gridHtml}
        <polygon points="${areaPoints}" fill="${fillColor}" />
        <polyline points="${points}" fill="none" stroke="${color}" stroke-width="2" stroke-linejoin="round" stroke-linecap="round" />
        ${circlesHtml}
        ${labelsHtml}
      </svg>
    </div>`;
  }

  /** Render a donut chart SVG string */
  function renderTortaChart(
    data: TortaPoint[],
    title: string,
    size = 280,
  ): string {
    const total = data.reduce((s, d) => s + d.value, 0);
    const outerRadius = size / 2;
    const innerRadius = size / 3;
    const circumference = 2 * Math.PI * outerRadius;
    const centerX = size / 2;
    const centerY = size / 2;
    const hasData = data.length > 0 && total > 0;
    const isSingle = data.length === 1;

    let segmentsHtml = '';
    let offset = 0;
    if (hasData) {
      for (let i = 0; i < data.length; i++) {
        const pct = data[i].value / total;
        const dashLen = isSingle ? circumference : pct * circumference;
        const dashGap = isSingle ? circumference * 0.001 : circumference - dashLen;
        segmentsHtml += `<circle cx="${centerX}" cy="${centerY}" r="${outerRadius}" fill="none"
          stroke="${data[i].color}"
          stroke-width="${isSingle ? outerRadius : outerRadius - innerRadius}"
          stroke-dasharray="${dashLen} ${dashGap}"
          stroke-dashoffset="${isSingle ? 0 : -offset}"
          transform="rotate(-90 ${centerX} ${centerY})" />`;
        offset += isSingle ? circumference : pct * circumference;
      }
    }

    // Legend
    let legendHtml = '';
    if (hasData) {
      legendHtml = '<div class="flex flex-wrap justify-center gap-4 mt-4">';
      for (const seg of data) {
        const pct = Math.round((seg.value / total) * 100);
        const label = seg.label.length > 24 ? seg.label.slice(0, 23) + '…' : seg.label;
        legendHtml += `<div class="flex items-center gap-2">
          <span class="w-3 h-3 rounded-sm flex-shrink-0" style="background-color:${seg.color}"></span>
          <span class="text-xs text-ceniza whitespace-nowrap">${escapeXml(label)}</span>
          <span class="text-xs text-humo font-medium">${pct}%</span>
        </div>`;
      }
      legendHtml += '</div>';
    }

    const centerContent = hasData
      ? `<text x="${centerX}" y="${centerY - 8}" text-anchor="middle" dominant-baseline="middle" fill="#2A2A2A" font-size="16" font-weight="bold">${formatCOP(total)}</text>
         <text x="${centerX}" y="${centerY + 12}" text-anchor="middle" dominant-baseline="middle" fill="#7b8084" font-size="10">${isSingle ? '100%' : 'Total'}</text>`
      : `<text x="${centerX}" y="${centerY}" text-anchor="middle" dominant-baseline="middle" fill="#7b8084" font-size="14">Sin datos</text>`;

    return `<div class="bg-white rounded-2xl p-6 shadow-card">
      ${title ? `<h3 class="text-base font-display font-bold text-humo mb-4">${escapeXml(title)}</h3>` : ''}
      <svg viewBox="0 0 ${size} ${size}" class="w-full h-auto" style="max-width:${size}px" xmlns="http://www.w3.org/2000/svg">
        <title>${escapeXml(title || '')}</title>
        ${segmentsHtml}
        ${centerContent}
      </svg>
      ${legendHtml}
    </div>`;
  }

  /** Render a horizontal bar chart SVG string */
  function renderBarChart(
    data: DataPoint[],
    title: string,
    barHeight = 32,
    barGap = 10,
  ): string {
    const hasData = data.length > 0;
    const maxValue = Math.max(...data.map((d) => d.value), 1);
    const labelWidth = 140;
    const valueWidth = 90;
    const chartWidth = 500 - labelWidth - valueWidth;
    const chartH = hasData ? data.length * (barHeight + barGap) - barGap : 100;
    const svgH = chartH + 40;
    const barColor = '#8B4513';

    if (!hasData) {
      return `<div class="bg-white rounded-2xl p-6 shadow-card">
        ${title ? `<h3 class="text-base font-display font-bold text-humo mb-4">${escapeXml(title)}</h3>` : ''}
        <svg viewBox="0 0 500 ${svgH}" class="w-full h-auto" xmlns="http://www.w3.org/2000/svg">
          <text x="250" y="${svgH / 2}" text-anchor="middle" dominant-baseline="middle" fill="#7b8084" font-size="14">Sin datos</text>
        </svg>
      </div>`;
    }

    let barsHtml = '';
    for (let i = 0; i < data.length; i++) {
      const y = 20 + i * (barHeight + barGap);
      const barW = (data[i].value / maxValue) * chartWidth;
      const label = data[i].label.length > 25 ? data[i].label.slice(0, 24) + '…' : data[i].label;
      barsHtml += `<text x="${labelWidth - 8}" y="${y + barHeight / 2}" text-anchor="end" dominant-baseline="middle" fill="#2A2A2A" font-size="11">${escapeXml(label)}</text>`;
      barsHtml += `<rect x="${labelWidth}" y="${y}" width="${chartWidth}" height="${barHeight}" fill="#F5F5F7" rx="4" />`;
      barsHtml += `<rect x="${labelWidth}" y="${y}" width="${barW}" height="${barHeight}" fill="${barColor}" rx="4" />`;
      barsHtml += `<text x="${labelWidth + barW + 8}" y="${y + barHeight / 2}" dominant-baseline="middle" fill="#2A2A2A" font-size="10" font-weight="500">${formatCOP(data[i].value)}</text>`;
    }

    barsHtml += `<text x="${labelWidth + chartWidth}" y="${svgH - 8}" text-anchor="end" fill="#7b8084" font-size="9">${formatShort(maxValue)}</text>`;

    return `<div class="bg-white rounded-2xl p-6 shadow-card">
      ${title ? `<h3 class="text-base font-display font-bold text-humo mb-4">${escapeXml(title)}</h3>` : ''}
      <svg viewBox="0 0 500 ${svgH}" class="w-full h-auto" xmlns="http://www.w3.org/2000/svg">
        <title>${escapeXml(title || '')}</title>
        ${barsHtml}
      </svg>
    </div>`;
  }

  function escapeXml(s: string): string {
    return s.replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;').replace(/"/g, '&quot;');
  }

  // ─── Period Labels ──────────────────────────────────────────────────────

  const PERIOD_LABELS: Record<string, string> = {
    '1m': 'Mes',
    '3m': 'Trimestre',
    '12m': 'Año',
  };

  const TORTA_COLORS = ['#8B4513', '#C4956A', '#5A4D3F', '#3D2E22', '#6D5E4D', '#A0845C', '#E8D5B7'];

  // ─── Chart Fetcher ──────────────────────────────────────────────────────

  async function fetchChartData(periodo: string): Promise<void> {
    const revenueEl = document.getElementById('chart-revenue');
    const ordersEl = document.getElementById('chart-orders');
    const productsEl = document.getElementById('chart-products');
    if (!revenueEl || !ordersEl || !productsEl) return;

    try {
      const res = await fetch(`/api/admin/dashboard?periodo=${periodo}`);
      if (!res.ok) {
        console.error('[Dashboard] API error:', res.status);
        return;
      }
      const data = await res.json();

      const periodLabel = PERIOD_LABELS[periodo] || 'Período';

      // Update Revenue chart
      revenueEl.innerHTML = renderLineChart(
        data.revenue || [],
        `Tendencia de Ingresos (${periodLabel})`,
      );

      // Update Orders chart (add colors)
      const ordersWithColors = (data.orders || []).map((o: any, i: number) => ({
        ...o,
        color: TORTA_COLORS[i % TORTA_COLORS.length],
      }));
      ordersEl.innerHTML = renderTortaChart(
        ordersWithColors,
        `Órdenes por Estado (${periodLabel})`,
      );

      // Update Products chart
      productsEl.innerHTML = renderBarChart(
        data.products || [],
        `Top 5 Productos (${periodLabel})`,
      );
    } catch (err) {
      console.error('[Dashboard] Fetch error:', err);
    }
  }

  // ─── Init ───────────────────────────────────────────────────────────────

  function initPage() {
    // Count-up animation for stats
    function animateCountUp(el: HTMLElement, target: number, duration = 800) {
      const start = 0;
      const startTime = performance.now();

      function update(currentTime: number) {
        const elapsed = currentTime - startTime;
        const progress = Math.min(elapsed / duration, 1);
        const eased = 1 - Math.pow(1 - progress, 3);
        const current = Math.floor(start + (target - start) * eased);
        el.textContent = formatValue(current);
        if (progress < 1) {
          requestAnimationFrame(update);
        } else {
          el.textContent = formatValue(target);
        }
      }
      requestAnimationFrame(update);
    }

    function formatValue(num: number): string {
      if (num >= 1000000) return '$' + (num / 1000000).toFixed(1) + 'M';
      if (num >= 1000) return '$' + (num / 1000).toFixed(0) + 'K';
      return String(num);
    }

    document.querySelectorAll('[data-count-value]').forEach((el) => {
      const target = parseInt(el.getAttribute('data-count-value') || '0', 10);
      if (target > 0) {
        animateCountUp(el as HTMLElement, target);
      }
    });

    // Period selector — dynamic fetch
    const periodSelector = document.getElementById('period-selector') as HTMLSelectElement;
    periodSelector?.addEventListener('change', () => {
      const selectedPeriod = periodSelector.value; // '1m' | '3m' | '12m'
      fetchChartData(selectedPeriod);
    });
  }

  initPage();
  if (!(window as any).__dashboardInitDone) {
    (window as any).__dashboardInitDone = true;
    document.addEventListener('astro:page-load', initPage);
  }
</script>
