---
/**
 * Root homepage (SSG) — serves Spanish (default locale) content at /
 *
 * `prefixDefaultLocale: false` means Astro does NOT generate /es/index.html
 * automatically for a root-level page — this file ensures dist/client/index.html
 * exists by rendering the ES locale's Layout + GraphSchema + HomeContent.
 */

import Layout from '@/layouts/Layout.astro';
import HomeContent from '@/components/home/HomeContent.astro';
import GraphSchema from '@/components/seo/GraphSchema.astro';
import { useTranslations, type Locale } from '@/i18n';

const locale = 'es';
const t = useTranslations(locale);

const homeTitles: Record<Locale, string> = {
  es: 'Rapé do Acre Colombia — Medicina Ancestral',
  en: 'Rapé do Acre Colombia — Amazonian Sacred Snuff',
  pt: 'Rapé do Acre Colômbia — Medicina Ancestral',
};

const homeDescriptions: Record<Locale, string> = {
  es: 'Rapé amazónico del Acre, Brasil. 20g por $70.000 COP ($3.500/g). Empaque hermético al vacío. Envío a todo Colombia. Tisunú, Pariká, Pixurí y más variedades.',
  en: 'Authentic rapé from Acre, Brazil. 20g for $19 USD ($0.95/g). Vacuum sealed at origin. Ships from Colombia. Tsunu, Parika, Pixuri and more.',
  pt: 'Rapé amazônico do Acre, Brasil. 20g por R$95 BRL (R$4,75/g). Embalagem hermética a vácuo. Envio para toda a Colômbia.',
};
---

<Layout title={homeTitles.es} description={homeDescriptions.es} locale="es" ogImage="/images/og-default.svg">
  <link rel="preload" as="image" href="/images/productos/rape/bobinsana-rape-2.webp" slot="head" />
  <GraphSchema slot="head" locale="es" />
  <HomeContent locale="es" />
</Layout>
