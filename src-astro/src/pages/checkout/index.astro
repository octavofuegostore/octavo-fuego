---
import Layout from '@/layouts/Layout.astro';
import { useTranslations, getLocaleFromUrl } from '@/i18n';
import { CheckoutForm } from '@/components/checkout/CheckoutForm';
import { OrderSummary } from '@/components/checkout/OrderSummary';
import PaymentBanner from '@/components/PaymentBanner.astro';

const locale = getLocaleFromUrl(Astro.url);
const t = useTranslations(locale);
---

<Layout title={t.cart.irCheckout} description={t.common.tagline} locale={locale}>
  <meta name="robots" content="noindex" slot="head" />
  <section class="py-16 md:py-24">
    <div class="max-w-6xl mx-auto px-6 md:px-12">
      <!-- Header -->
      <div class="text-center mb-12">
        <h1 class="font-display heading-lg font-bold mb-4">
          {t.cart.irCheckout}
        </h1>
      </div>



      <!-- Checkout Content -->
      <div class="grid lg:grid-cols-3 gap-12">
        <!-- Form -->
        <div class="lg:col-span-2">
          <CheckoutForm locale={locale} client:load />
        </div>

        <!-- Order Summary -->
        <div class="lg:col-span-1">
          <OrderSummary locale={locale} client:load />
        </div>
      </div>

      <!-- Payment Methods -->
      <div class="mt-8 max-w-md mx-auto border border-gray-200 bg-papel/50 p-6 rounded-2xl">
        <PaymentBanner variant="light" locale={locale} />
      </div>
    </div>
  </section>
</Layout>