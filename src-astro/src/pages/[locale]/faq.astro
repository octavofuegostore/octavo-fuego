---
/**
 * FAQ page — renders at /faq, /en/faq, /pt/faq
 * Trust Foundation SEO page with FAQPage schema.
 */
import Layout from '@/layouts/Layout.astro';
import { type Locale } from '@/i18n';


import { getLocaleStaticPaths } from "@/i18n/staticPaths";

export async function getStaticPaths() { return getLocaleStaticPaths(); }

const locale_ = (Astro.currentLocale || 'es') as Locale;

const title = 'Preguntas Frecuentes — Octavo Fuego';
const description = 'Resolvemos tus dudas sobre rapé do Acre, compras, envíos, conservación y envíos internacionales.';
const canonicalUrl = `https://octavofuego.com${Astro.url.pathname}`;

const faqs = [
  {
    question: '¿Qué es el rapé do Acre?',
    answer: 'El rapé do Acre es una medicina ancestral elaborada con tabaco y cenizas específicas de la Amazonía brasileña.',
  },
  {
    question: '¿Cómo comprar en Octavo Fuego?',
    answer: 'Puedes comprar a través de nuestra tienda online o escribirnos directamente por WhatsApp.',
  },
  {
    question: '¿Cuánto cuesta el envío?',
    answer: 'El costo de envío depende de la ciudad de destino y el peso del pedido.',
  },
  {
    question: '¿Cuánto tiempo tarda la entrega?',
    answer: 'Los envíos nacionales suelen tardar entre 2 y 5 días hábiles dependiendo de la ubicación.',
  },
  {
    question: '¿Cómo se conserva el rapé?',
    answer: 'Se recomienda conservar el rapé en un lugar fresco, seco y alejado de la luz directa. Nuestro empaque al vacío ayuda a preservar la frescura por más tiempo.',
  },
  {
    question: '¿Hacen envíos internacionales?',
    answer: 'Actualmente realizamos envíos a Colombia y Brasil. Para otros países, escríbenos por WhatsApp y evaluamos caso a caso.',
  },
];

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  '@id': `${canonicalUrl}#faq`,
  url: canonicalUrl,
  name: title,
  description,
  mainEntity: faqs.map((faq) => ({
    '@type': 'Question',
    name: faq.question,
    acceptedAnswer: {
      '@type': 'Answer',
      text: faq.answer,
    },
  })),
};
---

<Layout title={title} description={description} locale={locale_} ogImage="/images/og-default.svg">
  <script type="application/ld+json" slot="head" set:html={JSON.stringify(faqSchema)} />

  <div class="max-w-3xl mx-auto px-6 py-16 md:py-24">
    <h1 class="font-display heading-xl font-bold text-[var(--near-black)] mb-6">
      Preguntas Frecuentes — Octavo Fuego
    </h1>

    <section class="mb-12">
      <div class="bg-amber-50 border border-amber-200 rounded-xl p-6 text-amber-800 text-sm">
        <p class="font-medium mb-1">⚠️ Contenido pendiente</p>
        <p>Esta sección está siendo redactada. Vuelve pronto para leer el contenido completo.</p>
      </div>
    </section>

    <section aria-labelledby="faq-list">
      <h2 id="faq-list" class="sr-only">Listado de preguntas frecuentes</h2>
      <div class="space-y-8">
        {faqs.map((faq, index) => (
          <article class="p-6 border border-[var(--color-border-subtle)] rounded-[var(--radius-card)]">
            <h3 class="font-display heading-md font-bold text-[var(--near-black)] mb-3">
              {faq.question}
            </h3>
            <!-- 🖊️ USUARIO: reemplazar este texto -->
            <p class="text-[var(--ceniza)] leading-relaxed">
              {faq.answer}
            </p>
          </article>
        ))}
      </div>
    </section>
  </div>
</Layout>
