const page = content[locale_] ?? content.es;
const canonicalUrl = `https://octavofuego.com${Astro.url.pathname}`;

const webpageSchema = {
  '@context': 'https://schema.org',
  '@type': 'WebPage',
  '@id': `${canonicalUrl}#webpage`,
  url: canonicalUrl,
  name: page.title,
  description: page.description,
  dateModified: '2026-08-04',
  isPartOf: {
    '@id': 'https://octavofuego.com/#website',
  },
  about: {
    '@id': 'https://octavofuego.com/#organization',
  },
};
---

<Layout title={page.title} description={page.description} locale={locale_} ogImage="/images/og-default.svg">
  <script type="application/ld+json" slot="head" set:html={JSON.stringify(webpageSchema)} />

  <div class="max-w-4xl mx-auto px-6 py-16 md:py-24">
    <h1 class="font-display heading-xl font-bold text-[var(--near-black)] mb-4">
      {page.title}
    </h1>
    <p class="text-sm text-[var(--ceniza)] mb-12">{page.updated}</p>

    <!-- Table of Contents -->
    <nav aria-labelledby="toc-heading" class="mb-16 p-6 bg-[var(--color-surface-warm)] rounded-[var(--radius-card)]">
      <h2 id="toc-heading" class="font-display heading-md font-bold text-[var(--near-black)] mb-4">{page.toc}</h2>
      <ol class="space-y-2">
        {page.sections.map((section) => (
          <li>
            <a href={`#${section.id}`} class="text-[var(--color-action-primary)] hover:underline">
              {section.label}
            </a>
          </li>
        ))}
      </ol>
    </nav>

    {page.sections.map((section) => (
      <section class="mb-16" id={section.id}>
        <h2 class="font-display heading-lg font-bold text-[var(--near-black)] mb-4">{section.label}</h2>
        {section.items.map((item) => (
          <div class="mb-4">
            {item.title && (
              <h3 class="font-display heading-md font-bold text-[var(--near-black)] mb-2 mt-6">{item.title}</h3>
            )}
            <p class="text-[var(--ceniza)] leading-relaxed">
              {item.text}
              {item.link && (
                <a href={item.link.href} class="text-[var(--color-action-primary)] hover:underline">
                  {' '}{item.link.label}
                </a>
              )}
            </p>
          </div>
        ))}
      </section>
    ))}
  </div>
</Layout>
