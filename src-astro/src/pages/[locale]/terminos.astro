import Layout from '@/layouts/Layout.astro';
import { type Locale } from '@/i18n';
import { getLocaleStaticPaths } from '@/i18n/staticPaths';

export async function getStaticPaths() { return getLocaleStaticPaths(); }

const locale_ = (Astro.currentLocale || 'es') as Locale;

// Internal links always point to the real built [locale] pages.
const href = (path: string) => `/${locale_}${path}`;

type LegalItem = { title?: string; text: string; link?: { href: string; label: string } };
type LegalSection = { id: string; label: string; items: LegalItem[] };

interface PageContent {
  title: string;
  description: string;
  updated: string;
  toc: string;
  sections: LegalSection[];
}

