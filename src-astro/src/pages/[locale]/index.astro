---
/**
 * Locale-aware homepage — renders at /, /en, /pt
 * Preserves Hero + Trust Badges, REPLACES quiz with real intention categories,
 * adds ProphecyTeaser, updates product links to /tienda
 */

import Layout from '@/layouts/Layout.astro';
import HomeContent from '@/components/home/HomeContent.astro';
import GraphSchema from '@/components/seo/GraphSchema.astro';
import { useTranslations, type Locale } from '@/i18n';


import { getLocaleStaticPaths } from "@/i18n/staticPaths";

export async function getStaticPaths() { return getLocaleStaticPaths(); }

const locale_ = (Astro.currentLocale || 'es') as Locale;
const t = useTranslations(locale_);

// F2.1: Homepage title + meta descriptions per locale
const homeTitles: Record<Locale, string> = {
  es: 'Rapé do Acre Colombia — Medicina Ancestral',
  en: 'Rapé do Acre Colombia — Amazonian Sacred Snuff',
  pt: 'Rapé do Acre Colômbia — Medicina Ancestral',
};

const homeDescriptions: Record<Locale, string> = {
  es: 'Rapé amazónico del Acre, Brasil. 20g por $70.000 COP ($3.500/g). Empaque hermético al vacío. Envío a todo Colombia. Tsunú, Pariká, Pixurí y más variedades.',
  en: 'Authentic rapé from Acre, Brazil. 20g for $19 USD ($0.95/g). Vacuum sealed at origin. Ships from Colombia. Tsunu, Parika, Pixuri and more.',
  pt: 'Rapé amazônico do Acre, Brasil. 20g por R$95 BRL (R$4,75/g). Embalagem hermética a vácuo. Envio para toda a Colômbia.',
};
---

<Layout title={homeTitles[locale_]} description={homeDescriptions[locale_]} locale={locale_} ogImage="/images/og-default.svg">
  <GraphSchema slot="head" locale={locale_} />
  <HomeContent locale={locale_} />
</Layout>
