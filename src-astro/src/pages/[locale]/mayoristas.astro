---
import Layout from '@/layouts/Layout.astro';
import WholesaleStoreJsonLd from '@/components/seo/WholesaleStoreJsonLd.astro';
import { useTranslations, type Locale } from '@/i18n';
import { localeUrl } from '@/i18n/links';


import { getLocaleStaticPaths } from "@/i18n/staticPaths";

export async function getStaticPaths() { return getLocaleStaticPaths(); }

const locale_ = (Astro.currentLocale || 'es') as Locale;
const t = useTranslations(locale_);

const title = t.mayoristas.meta_title;
const description = t.mayoristas.meta_desc;

const phoneNumber = '573172137932';
const whatsappMessage = t.mayoristas.whatsapp_wholesale;
const whatsappUrl = `https://wa.me/${phoneNumber}?text=${encodeURIComponent(whatsappMessage)}`;

const keywords = t.mayoristas.keywords.join(', ');
---

<Layout title={title} description={description} locale={locale_}>
  <Fragment slot="head">
    <meta name="robots" content="index, follow" />
    <meta name="keywords" content={keywords} />
    <WholesaleStoreJsonLd />
  </Fragment>

  <section class="max-w-6xl mx-auto px-4 py-16">
    <!-- Hero -->
    <div class="text-center mb-20">
      <h1
        class="font-display heading-xl font-bold text-[var(--near-black)] mb-6 leading-tight"
      >
        {t.mayoristas.hero_title}
      </h1>
      <p class="text-lg text-ceniza max-w-3xl mx-auto mb-8">
        {t.mayoristas.hero_desc} {t.mayoristas.hero_desc_extra}
      </p>
      <div class="flex flex-col sm:flex-row gap-4 justify-center">
        <a
          href={localeUrl('/tienda', locale_)}
          class="inline-block bg-[var(--tabaco-base)] text-white px-8 py-3 rounded-lg font-semibold hover:bg-[var(--color-action-hover)] transition-colors"
        >
          {t.mayoristas.cta_catalogo}
        </a>
        <a
          href={whatsappUrl}
          target="_blank"
          rel="noopener noreferrer"
          class="inline-block border-2 border-[var(--tabaco-base)] text-[var(--tabaco-base)] px-8 py-3 rounded-lg font-semibold hover:bg-[var(--tabaco-base)] hover:text-white transition-colors"
        >
          {t.mayoristas.cta_whatsapp}
        </a>
      </div>
    </section>

    <!-- Ventajas competitivas -->
    <section class="grid md:grid-cols-3 gap-8 mb-20">
      <div class="bg-papel rounded-2xl p-8 text-center">
        <h2 class="font-display text-2xl font-bold text-[var(--near-black)] mb-4">
          {t.mayoristas.ventaja_origen}
        </h2>
        <p class="text-ceniza">
          {t.mayoristas.ventaja_origen_desc}
        </p>
      </div>
      <div class="bg-papel rounded-2xl p-8 text-center">
        <h2 class="font-display text-2xl font-bold text-[var(--near-black)] mb-4">
          {t.mayoristas.ventaja_empaque}
        </h2>
        <p class="text-ceniza">
          {t.mayoristas.ventaja_empaque_desc}
        </p>
      </div>
      <div class="bg-papel rounded-2xl p-8 text-center">
        <h2 class="font-display text-2xl font-bold text-[var(--near-black)] mb-4">
          {t.mayoristas.ventaja_envio}
        </h2>
        <p class="text-ceniza">
          {t.mayoristas.ventaja_envio_desc}
        </p>
      </div>
    </section>

    <!-- Variedades para mayoristas -->
    <section class="mb-20">
      <h2
        class="font-display heading-xl font-bold text-[var(--near-black)] mb-8 text-center"
      >
        {t.mayoristas.variedades_title}
      </h2>
      <div class="grid md:grid-cols-3 gap-6">
        <div class="border border-[var(--color-action-subtle)] rounded-2xl p-6">
          <h3 class="font-display text-xl font-bold text-[var(--near-black)] mb-2">
            Tisunú
          </h3>
          <p class="text-ceniza text-sm mb-4">{t.mayoristas.variedad_tisunu_desc}</p>
          <p class="text-sm text-[var(--tabaco-base)] font-semibold">
            {t.mayoristas.variedad_precio.replace('{price}', '$3.500')}
          </p>
        </div>
        <div class="border border-[var(--color-action-subtle)] rounded-2xl p-6">
          <h3 class="font-display text-xl font-bold text-[var(--near-black)] mb-2">
            Pixurí
          </h3>
          <p class="text-ceniza text-sm mb-4">{t.mayoristas.variedad_pixuri_desc}</p>
          <p class="text-sm text-[var(--tabaco-base)] font-semibold">
            {t.mayoristas.variedad_precio.replace('{price}', '$3.500')}
          </p>
        </div>
        <div class="border border-[var(--color-action-subtle)] rounded-2xl p-6">
          <h3 class="font-display text-xl font-bold text-[var(--near-black)] mb-2">
            Pariká
          </h3>
          <p class="text-ceniza text-sm mb-4">{t.mayoristas.variedad_parika_desc}</p>
          <p class="text-sm text-[var(--tabaco-base)] font-semibold">
            {t.mayoristas.variedad_precio.replace('{price}', '$3.500')}
          </p>
        </div>
        <div class="border border-[var(--color-action-subtle)] rounded-2xl p-6">
          <h3 class="font-display text-xl font-bold text-[var(--near-black)] mb-2">
            Cumarú de Cheiro
          </h3>
          <p class="text-ceniza text-sm mb-4">{t.mayoristas.variedad_cumaru_desc}</p>
          <p class="text-sm text-[var(--tabaco-base)] font-semibold">
            {t.mayoristas.variedad_precio.replace('{price}', '$3.500')}
          </p>
        </div>
        <div class="border border-[var(--color-action-subtle)] rounded-2xl p-6">
          <h3 class="font-display text-xl font-bold text-[var(--near-black)] mb-2">
            Vena de Pajé
          </h3>
          <p class="text-ceniza text-sm mb-4">{t.mayoristas.variedad_vena_desc}</p>
          <p class="text-sm text-[var(--tabaco-base)] font-semibold">
            {t.mayoristas.variedad_precio.replace('{price}', '$3.500')}
          </p>
        </div>
        <div class="border border-[var(--color-action-subtle)] rounded-2xl p-6">
          <h3 class="font-display text-xl font-bold text-[var(--near-black)] mb-2">
            Kuripes
          </h3>
          <p class="text-ceniza text-sm mb-4">{t.mayoristas.variedad_kuripes_desc}</p>
          <p class="text-sm text-[var(--tabaco-base)] font-semibold">
            {t.mayoristas.variedad_proximamente}
          </p>
        </div>
      </div>
    </section>

    <!-- CTA Mid-page -->
    <section class="bg-[var(--tabaco-base)] rounded-2xl p-12 text-center mb-20">
      <h2 class="font-display text-3xl font-bold text-white mb-4">
        {t.mayoristas.cta_mid_title}
      </h2>
      <p class="text-[var(--color-text-on-dark)] mb-8 max-w-2xl mx-auto">
        {t.mayoristas.cta_mid_desc}
      </p>
      <a
        href={whatsappUrl}
        target="_blank"
        rel="noopener noreferrer"
        class="inline-block bg-white text-[var(--tabaco-base)] px-10 py-4 rounded-lg font-bold text-lg hover:bg-gray-100 transition-colors"
      >
        {t.mayoristas.cta_mid_btn}
      </a>
    </section>

    <!-- FAQ -->
    <section class="max-w-3xl mx-auto mb-20">
      <h2
        class="font-display heading-xl font-bold text-[var(--near-black)] mb-8 text-center"
      >
        {t.mayoristas.faq_title}
      </h2>

      <div class="space-y-6">
        <div class="border-b border-gray-200 pb-6">
          <h3 class="font-display text-xl font-bold text-[var(--near-black)] mb-2">
            {t.mayoristas.faq_q1}
          </h3>
          <p class="text-ceniza">
            {t.mayoristas.faq_a1}
          </p>
        </div>
        <div class="border-b border-gray-200 pb-6">
          <h3 class="font-display text-xl font-bold text-[var(--near-black)] mb-2">
            {t.mayoristas.faq_q2}
          </h3>
          <p class="text-ceniza">
            {t.mayoristas.faq_a2}
          </p>
        </div>
        <div class="border-b border-gray-200 pb-6">
          <h3 class="font-display text-xl font-bold text-[var(--near-black)] mb-2">
            {t.mayoristas.faq_q3}
          </h3>
          <p class="text-ceniza">
            {t.mayoristas.faq_a3}
          </p>
        </div>
        <div class="border-b border-gray-200 pb-6">
          <h3 class="font-display text-xl font-bold text-[var(--near-black)] mb-2">
            {t.mayoristas.faq_q4}
          </h3>
          <p class="text-ceniza">
            {t.mayoristas.faq_a4}
          </p>
        </div>
      </div>
    </section>

    <!-- Schema -->
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "Product",
      "name": "Rapé do Acre — Distribución Mayorista",
      "description": t.mayoristas.meta_desc,
      "brand": {
        "@type": "Brand",
        "name": "Octavo Fuego"
      },
      "offers": {
        "@type": "AggregateOffer",
        "priceCurrency": "COP",
        "lowPrice": "3500",
        "highPrice": "3500",
        "offerCount": "5"
      },
      "areaServed": {
        "@type": "Country",
        "name": "Colombia"
      }
    })} />
  </section>
</Layout>
