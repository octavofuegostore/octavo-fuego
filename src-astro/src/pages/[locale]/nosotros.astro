---
/**
 * About page — renders at /nosotros, /en/nosotros, /pt/nosotros
 * Trust Foundation SEO page with AboutPage schema.
 */
import Layout from '@/layouts/Layout.astro';
import { type Locale } from '@/i18n';

export const prerender = false;

const locale_ = (Astro.currentLocale || 'es') as Locale;

const title = 'Nosotros — Octavo Fuego';
const description = 'Conoce la historia, misión y comunidades aliadas de Octavo Fuego. Rapé do Acre de origen amazónico.';
const canonicalUrl = `https://octavofuego.com${Astro.url.pathname}`;

const aboutSchema = {
  '@context': 'https://schema.org',
  '@type': 'AboutPage',
  '@id': `${canonicalUrl}#about`,
  url: canonicalUrl,
  name: title,
  description,
  mainEntity: {
    '@type': 'Organization',
    '@id': 'https://octavofuego.com/#organization',
    name: 'Octavo Fuego',
    alternateName: 'Octavo Fuego — Rapé do Acre',
    url: 'https://octavofuego.com',
    foundingDate: '2026',
    sameAs: [
      'https://www.instagram.com/octavofuego',
      'https://www.facebook.com/octavofuego',
      'https://wa.me/573172137932',
    ],
    contactPoint: {
      '@type': 'ContactPoint',
      telephone: '+573172137932',
      contactType: 'customer service',
      availableLanguage: ['Spanish', 'English', 'Portuguese'],
    },
  },
};
---

<Layout title={title} description={description} locale={locale_} ogImage="/images/og-default.svg">
  <script type="application/ld+json" slot="head" set:html={JSON.stringify(aboutSchema)} />

  <div class="max-w-3xl mx-auto px-6 py-16 md:py-24">
    <h1 class="font-display heading-xl font-bold text-[var(--near-black)] mb-6">
      Nosotros — Octavo Fuego
    </h1>

    <!-- Hero Section -->
    <section class="mb-16">
      <p class="text-lg text-[var(--ceniza)] leading-relaxed">
        Octavo Fuego nace como un puente entre la medicina ancestral amazónica y quienes buscan conectar con su propósito. Nuestro trabajo respeta los tiempos de la selva, las comunidades que la habitan y la sagrada relación con el rapé. Cada producto que ofrecemos lleva consigo una historia de cuidado, conocimiento transmitido por generaciones y una profunda conexión con la tierra.
      </p>
    </section>

    <!-- Nuestra Historia -->
    <section class="mb-16" id="historia">
      <h2 class="font-display heading-lg font-bold text-[var(--near-black)] mb-4">Nuestra Historia</h2>
      <p class="text-[var(--ceniza)] leading-relaxed mb-4">
        Octavo Fuego nace de un encuentro: el de un viajero con la selva amazónica y el de comunidades enteras que han cuidado la medicina del rapé durante siglos. Inspirados por la profecía de los Siete Fuegos, creemos que ha llegado el momento de tender puentes entre el conocimiento ancestral y quienes lo buscan con corazón sincero.
      </p>
      <p class="text-[var(--ceniza)] leading-relaxed">
        Desde el departamento de Acre, en la Amazonía brasileña, trabajamos hombro a hombro con familias indígenas que mantienen vivas las recetas tradicionales. Cada rapé que ofrecemos es el resultado de un proceso cuidadoso: desde la cosecha consciente de las hojas de tabaco silvestre hasta la preparación con cenizas de árboles sagrados, siguiendo métodos que han pasado de abuelos a nietos durante incontables generaciones.
      </p>
    </section>

    <!-- Comunidades -->
    <section class="mb-16" id="comunidades">
      <h2 class="font-display heading-lg font-bold text-[var(--near-black)] mb-4">Comunidades</h2>
      <!-- 🖊️ USUARIO: reemplazar este texto -->
      <p class="text-[var(--ceniza)] leading-relaxed mb-4">
        Trabajamos de la mano de comunidades tradicionales de la Amazonía, entre ellas Yawanawá, Nukini, Kaxinawá y Shanenawa. Cada una aporta su propia alquimia, conocimiento y respeto por la medicina.
      </p>
      <p class="text-[var(--ceniza)] leading-relaxed">
        Creemos en una relación de reciprocidad: cada compra honra el conocimiento de quienes preparan la medicina y contribuye al fortalecimiento de sus comunidades. Trabajamos directamente con líderes indígenas que garantizan la autenticidad y la calidad de cada lote.
      </p>
    </section>

    <!-- Nuestra Misión -->
    <section class="mb-16" id="mision">
      <h2 class="font-display heading-lg font-bold text-[var(--near-black)] mb-4">Nuestra Misión</h2>
      <!-- 🖊️ USUARIO: reemplazar este texto -->
      <p class="text-[var(--ceniza)] leading-relaxed mb-4">
        Nuestra misión es ofrecer rapé do Acre de origen verificado, empacado al vacío y distribuido con respeto. Queremos que cada persona que reciba nuestra medicina sienta la intención con la que fue elaborada.
      </p>
      <p class="text-[var(--ceniza)] leading-relaxed">
        Cada paso de nuestra cadena — desde la selva hasta tus manos — está guiado por la transparencia. Queremos que sepas exactamente de dónde viene tu medicina, quiénes la prepararon y con qué intención fue creada. Esa es nuestra forma de honrar tanto el conocimiento ancestral como tu confianza.
      </p>
    </section>

    <!-- Por qué el Acre -->
    <section class="mb-16" id="acre">
      <h2 class="font-display heading-lg font-bold text-[var(--near-black)] mb-4">Por qué el Acre</h2>
      <!-- 🖊️ USUARIO: reemplazar este texto -->
      <p class="text-[var(--ceniza)] leading-relaxed mb-4">
        El estado de Acre, en la frontera occidental de Brasil, es reconocido mundialmente como uno de los territorios vivos de la medicina del rapé. Sus comunidades indígenas han preservado recetas, cantos y técnicas de preparación durante generaciones.
      </p>
      <p class="text-[var(--ceniza)] leading-relaxed">
        Esta región fronteriza, bañada por los ríos Purus y Acre, posee una biodiversidad única que se refleja en la calidad de sus tabacos y plantas medicinales. Al elegir rapé del Acre, no solo accedes a una medicina de origen legítimo, sino que apoyas la conservación de la selva y el modo de vida de quienes la protegen desde adentro.
      </p>
    </section>
  </div>
</Layout>
