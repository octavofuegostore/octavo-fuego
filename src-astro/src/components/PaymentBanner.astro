---
interface Props {
  variant: 'dark' | 'light';
  locale?: 'es' | 'en' | 'pt';
}

import { t } from '@/i18n';
import { Icon } from 'astro-icon/components';

const { variant = 'dark', locale = 'es' } = Astro.props;

const mutedColor = variant === 'dark' ? 'text-[var(--color-text-on-dark)]/70' : 'text-ceniza';

// Locale-based payment methods
type PaymentMethod = {
  id: string;
  label: string;
};

function getPaymentMethods(locale: string): PaymentMethod[] {
  switch (locale) {
    case 'pt':
      return [
        { id: 'pix', label: 'Pix' },
        { id: 'boleto', label: 'Boleto' },
        { id: 'visa', label: 'Visa' },
        { id: 'mastercard', label: 'Mastercard' },
        { id: 'amex', label: 'Amex' },
        { id: 'diners', label: 'Diners' },
        { id: 'discover', label: 'Discover' },
        { id: 'mercadopago', label: 'MercadoPago' },
      ];
    case 'en':
      return [
        { id: 'stripe', label: 'Stripe' },
        { id: 'visa', label: 'Visa' },
        { id: 'mastercard', label: 'Mastercard' },
        { id: 'amex', label: 'Amex' },
        { id: 'diners', label: 'Diners' },
        { id: 'discover', label: 'Discover' },
      ];
    default: // 'es' — Colombia
      return [
        { id: 'pse', label: 'PSE' },
        { id: 'nequi', label: 'Nequi' },
        { id: 'daviplata', label: 'Daviplata' },
        { id: 'bancolombia', label: 'Bancolombia' },
        { id: 'codensa', label: 'Codensa' },
        { id: 'visa', label: 'Visa' },
        { id: 'mastercard', label: 'Mastercard' },
        { id: 'amex', label: 'Amex' },
        { id: 'diners', label: 'Diners' },
        { id: 'discover', label: 'Discover' },
        { id: 'bold', label: 'Bold' },
        { id: 'mercadopago', label: 'MercadoPago' },
      ];
  }
}

const methods = getPaymentMethods(locale);
const t_ = (key: string) => t(key, locale);
---

<div class="space-y-4">
  <div class="grid grid-cols-3 gap-4 md:gap-5" role="list" aria-label="Métodos de pago aceptados">
    {methods.map((method) => (
      <div role="listitem" class="flex items-center justify-center w-16 h-16 rounded-lg">
        <img
          src={`/images/payment/${variant}/${method.id}.svg`}
          alt={method.label}
          class="max-h-12 max-w-12 w-auto object-contain hover:scale-110 transition-transform duration-200"
          loading="lazy"
          width="64"
          height="64"
        />
      </div>
    ))}
  </div>

  <div class={`flex items-center gap-2 pt-4 mt-4 border-t border-tabaco/[0.1] text-xs ${mutedColor}`}>
    <Icon name="solar:lock-bold" class="w-3.5 h-3.5" />
    <span>{t_('payment.securedBy')}</span>
  </div>
</div>
