---
interface Props {
  variant: 'dark' | 'light';
  locale?: 'es' | 'en' | 'pt';
}

import { t, type Locale } from '@/i18n';
import { Icon } from 'astro-icon/components';

const { variant = 'dark', locale = 'es' } = Astro.props;

const mutedColor = variant === 'dark' ? 'text-[var(--color-text-on-dark)]/70' : 'text-[#4a4a4a]';

// Locale-based payment methods
type PaymentMethod = {
  id: string;
  label: string;
};

function getPaymentMethods(locale: Locale): PaymentMethod[] {
  switch (locale) {
    case 'pt':
      return [
        { id: 'pix', label: 'Pix' },
        { id: 'boleto', label: 'Boleto' },
        { id: 'visa', label: 'Visa' },
        { id: 'mastercard', label: 'Mastercard' },
        { id: 'amex', label: 'Amex' },
        { id: 'diners', label: 'Diners' },
        { id: 'discover', label: 'Discover' },
        { id: 'mercadopago', label: 'MercadoPago' },
      ];
    case 'en':
      return [
        { id: 'stripe', label: 'Stripe' },
        { id: 'visa', label: 'Visa' },
        { id: 'mastercard', label: 'Mastercard' },
        { id: 'amex', label: 'Amex' },
        { id: 'diners', label: 'Diners' },
        { id: 'discover', label: 'Discover' },
      ];
    default: // 'es' — Colombia
      return [
        { id: 'pse', label: 'PSE' },
        { id: 'nequi', label: 'Nequi' },
        { id: 'daviplata', label: 'Daviplata' },
        { id: 'bancolombia', label: 'Bancolombia' },
        { id: 'codensa', label: 'Codensa' },
        { id: 'visa', label: 'Visa' },
        { id: 'mastercard', label: 'Mastercard' },
        { id: 'amex', label: 'Amex' },
        { id: 'diners', label: 'Diners' },
        { id: 'discover', label: 'Discover' },
        { id: 'bold', label: 'Bold' },
        { id: 'mercadopago', label: 'MercadoPago' },
      ];
  }
}

const methods = getPaymentMethods(locale);
const t_ = (key: string) => t(key, locale);
---

<div class="w-full flex flex-col items-start space-y-4">
  <h2 class="text-xs font-medium uppercase tracking-widest text-[var(--color-action-primary)] mb-2">
    {t_('payment.title')}
  </h2>
  <div class="w-full flex flex-wrap items-center justify-start gap-x-3 gap-y-3" role="list" aria-label={t_('payment.ariaList')}>
    {methods.map((method) => (
      <div role="listitem" class="flex items-center justify-center h-12">
        <img
          src={`/images/payment/${variant}/${method.id}.svg`}
          alt={method.label}
          width="32" height="32"
          class="h-8 w-auto object-contain hover:scale-105 transition-transform duration-200"
          loading="lazy"
        />
      </div>
    ))}
  </div>
  <div class={`flex items-center gap-2 pt-3 border-t border-tabaco/[0.08] text-xs ${mutedColor}`}>
    <Icon name="solar:lock-bold" class="w-3.5 h-3.5" aria-hidden="true" />
    <span>{t_('payment.securedBy')}</span>
  </div>
</div>
