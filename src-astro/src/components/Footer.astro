---
import { useTranslations } from '@/i18n';
import type { Locale } from '@/i18n';
import { Icon } from 'astro-icon/components';
import PaymentBanner from '@/components/PaymentBanner.astro';

interface Props {
  locale?: Locale;
}

const { locale = 'es' } = Astro.props;
const t = useTranslations(locale);

// Internal links always point to the real built [locale] pages.
// localeUrl() strips the prefix for ES, which would hit dead root SSR
// duplicates (e.g. /faq) instead of the canonical built /es/faq page.
const href = (path: string) => `/${locale}${path}`;
---

<footer class="bg-[var(--color-surface-warm)]">
  <div class="max-w-7xl mx-auto px-6 md:px-12 py-20 md:py-24">
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-8 md:gap-12 mb-12">
      <!-- Col 1: Identidad + Métodos de pago -->
      <div>
        <a href={href('/')} class="font-display text-2xl font-bold mb-4 block text-[var(--color-action-primary)]">
          {t.common.brand}
        </a>
        <p class="text-[var(--near-black)] text-sm mb-6 opacity-80">
          {t.common.tagline}
        </p>
        <p class="text-[#5C6063] text-xs max-w-xs">
          {t.footer.disclaimer}
        </p>
        <div class="mt-8 pt-6 border-t border-tabaco/20">
          <PaymentBanner variant="light" locale={locale} />
        </div>
      </div>

      <!-- Col 2: Productos -->
      <div>
        <h2 class="text-xs font-medium uppercase tracking-widest text-[var(--color-action-primary)] mb-6">
          {t.footer.productos}
        </h2>
        <ul class="space-y-3">
          <li>
            <a href={href('/tienda')} class="text-[var(--near-black)] text-sm hover:text-[var(--color-action-primary)] transition-colors">
              {t.nav.tienda}
            </a>
          </li>
          <li>
            <a href={href('/profecia')} class="text-[var(--near-black)] text-sm hover:text-[var(--color-action-primary)] transition-colors">
              {t.nav.profecia}
            </a>
          </li>
        </ul>
      </div>

      <!-- Col 3: Ayuda -->
      <div>
        <h2 class="text-xs font-medium uppercase tracking-widest text-[var(--color-action-primary)] mb-6">
          {t.footer.ayuda}
        </h2>
        <ul class="space-y-3">
          <li>
            <a href={href('/nosotros')} class="text-[var(--near-black)] text-sm hover:text-[var(--color-action-primary)] transition-colors">
              {t.nav.nosotros}
            </a>
          </li>
          <li>
            <a href={href('/blog')} class="text-[var(--near-black)] text-sm hover:text-[var(--color-action-primary)] transition-colors">
              {t.nav.blog}
            </a>
          </li>
          <li>
            <a href={href('/contacto')} class="text-[var(--near-black)] text-sm hover:text-[var(--color-action-primary)] transition-colors">
              {t.nav.contacto}
            </a>
          </li>
          <li>
            <a href={href('/faq')} class="text-[var(--near-black)] text-sm hover:text-[var(--color-action-primary)] transition-colors">
              {t.footer.faq}
            </a>
          </li>
          <li>
            <a href={href('/envios')} class="text-[var(--near-black)] text-sm hover:text-[var(--color-action-primary)] transition-colors">
              {t.footer.envios}
            </a>
          </li>
        </ul>
      </div>

      <!-- Col 4: Conecta -->
      <div>
        <h2 class="text-xs font-medium uppercase tracking-widest text-[var(--color-action-primary)] mb-6">
          {t.footer.conecta}
        </h2>
        <ul class="space-y-3 mb-6">
          <li>
            <a href="mailto:hola@octavofuego.com" class="text-[var(--near-black)] text-sm hover:text-[var(--color-action-primary)] transition-colors flex items-center gap-2 p-2">
              <Icon name="solar:letter-bold" class="w-5 h-5 shrink-0 text-[var(--color-action-primary)]/80" />
              hola@octavofuego.com
            </a>
          </li>
          <li>
            <a href="https://wa.me/573172137932" target="_blank" rel="noopener noreferrer" class="text-[var(--near-black)] text-sm hover:text-[var(--color-action-primary)] transition-colors flex items-center gap-2 p-2">
              <Icon name="solar:chat-round-bold" class="w-5 h-5 shrink-0 text-[var(--color-action-primary)]/80" />
              {t.footer.whatsapp}
            </a>
          </li>
          <li class="flex items-center gap-2 text-[var(--near-black)] text-sm p-2">
            <Icon name="solar:map-point-bold" class="w-5 h-5 shrink-0 text-[var(--color-action-primary)]/80" />
            <span>{t.footer.direccionFabrica}</span>
          </li>
          <li class="flex items-center gap-2 text-[var(--near-black)] text-sm p-2">
            <Icon name="solar:leaf-bold" class="w-5 h-5 shrink-0 text-[var(--color-action-primary)]/80" />
            <span>{t.footer.confianzaFooter}</span>
          </li>
          <li class="text-[#5C6063] text-xs">{t.footer.enviosZona}</li>
        </ul>

        <!-- Social Icons -->
        <div class="flex gap-4">
          <a
            href="https://instagram.com/octavofuego"
            target="_blank"
            rel="noopener noreferrer"
            class="text-[var(--near-black)] hover:text-[var(--color-action-primary)] transition-colors p-2"
            aria-label={t.footer.instagram}
          >
            <Icon name="ph:instagram-logo-duotone" class="w-6 h-6 text-[var(--color-action-primary)]" />
          </a>
          <a
            href="https://facebook.com/octavofuego"
            target="_blank"
            rel="noopener noreferrer"
            class="text-[var(--near-black)] hover:text-[var(--color-action-primary)] transition-colors p-2"
            aria-label={t.footer.facebook}
          >
            <Icon name="ph:facebook-logo-duotone" class="w-6 h-6 text-[var(--color-action-primary)]" />
          </a>
          <a
            href="https://wa.me/573172137932"
            target="_blank"
            rel="noopener noreferrer"
            class="text-[var(--near-black)] hover:text-[var(--color-action-primary)] transition-colors p-2"
            aria-label={t.footer.whatsapp}
          >
            <Icon name="ph:whatsapp-logo-duotone" class="w-6 h-6 text-[var(--color-action-primary)]" />
          </a>
        </div>
      </div>
    </div>

    <!-- Bottom Bar -->
    <div class="pt-8 border-t border-tabaco/20">
      <div class="flex flex-col md:flex-row justify-between items-center gap-4">
        <p class="text-[#5C6063] text-xs">
          {t.footer.copyright}
        </p>
        <div class="flex gap-6">
          <a href={href('/terminos')} class="text-[#5C6063] text-xs hover:text-[var(--color-action-primary)] transition-colors">
            {t.footer.terminos}
          </a>
          <a href={href('/privacidad')} class="text-[#5C6063] text-xs hover:text-[var(--color-action-primary)] transition-colors">
            {t.footer.privacidad}
          </a>
        </div>
      </div>
    </div>
  </div>
</footer>
