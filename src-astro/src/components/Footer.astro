---
import { useTranslations } from '@/i18n';
import type { Locale } from '@/i18n';
import { localeUrl } from '@/i18n/links';
import { Icon } from 'astro-icon/components';
import PaymentBanner from '@/components/PaymentBanner.astro';

interface Props {
  locale?: Locale;
}

const { locale = 'es' } = Astro.props;
const t = useTranslations(locale);
---

<footer class="bg-[var(--color-footer-bg)] text-white">
  <div class="max-w-7xl mx-auto px-6 md:px-12 py-20 md:py-24">
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-5 gap-8 md:gap-12 mb-12">
      <!-- Col 1: Logo + Tagline -->
      <div>
        <a href={localeUrl('/', locale)} class="font-display text-2xl font-bold mb-4 block text-white">
          {t.common.brand}
        </a>
        <p class="text-[var(--color-text-on-dark)] text-sm mb-6">
          {t.common.tagline}
        </p>
        <p class="text-[var(--color-text-on-dark)]/70 text-xs max-w-xs">
          {t.footer.disclaimer}
        </p>
      </div>

      <!-- Col 2: Métodos de pago -->
      <div class="md:col-span-2 lg:col-span-1">
        <h4 class="text-xs font-medium uppercase tracking-widest opacity-50 text-white mb-6">
          Métodos de pago
        </h4>
        <PaymentBanner variant="dark" locale={locale} />
      </div>

      <!-- Col 3: Productos -->
      <div>
        <h4 class="text-xs font-medium uppercase tracking-widest opacity-50 text-white mb-6">
          {t.footer.productos}
        </h4>
        <ul class="space-y-3">
          <li>
            <a href={localeUrl('/tienda', locale)} class="text-[var(--color-text-on-dark)] text-sm hover:text-white transition-colors">
              {t.nav.tienda}
            </a>
          </li>
          <li>
            <a href={localeUrl('/profecia', locale)} class="text-[var(--color-text-on-dark)] text-sm hover:text-white transition-colors">
              Profecía
            </a>
          </li>
        </ul>
      </div>

      <!-- Col 4: Ayuda -->
      <div>
        <h4 class="text-xs font-medium uppercase tracking-widest opacity-50 text-white mb-6">
          {t.footer.ayuda}
        </h4>
        <ul class="space-y-3">
          <li>
            <a href={localeUrl('/nosotros', locale)} class="text-[var(--color-text-on-dark)] text-sm hover:text-white transition-colors">
              {t.nav.nosotros}
            </a>
          </li>
          <li>
            <a href={localeUrl('/blog', locale)} class="text-[var(--color-text-on-dark)] text-sm hover:text-white transition-colors">
              {t.nav.blog}
            </a>
          </li>
          <li>
            <a href={localeUrl('/contacto', locale)} class="text-[var(--color-text-on-dark)] text-sm hover:text-white transition-colors">
              {t.nav.contacto}
            </a>
          </li>
          <li>
            <a href={localeUrl('/faq', locale)} class="text-[var(--color-text-on-dark)] text-sm hover:text-white transition-colors">
              {t.footer.faq}
            </a>
          </li>
          <li>
            <a href={localeUrl('/envios', locale)} class="text-[var(--color-text-on-dark)] text-sm hover:text-white transition-colors">
              {t.footer.envios}
            </a>
          </li>
        </ul>
      </div>

      <!-- Col 5: Conecta -->
      <div>
        <h4 class="text-xs font-medium uppercase tracking-widest opacity-50 text-white mb-6">
          {t.footer.conecta}
        </h4>
        <ul class="space-y-3 mb-6">
          <li>
            <a href="mailto:hola@octavofuego.com" class="text-[var(--color-text-on-dark)] text-sm hover:text-white transition-colors flex items-center gap-2 p-2">
              <Icon name="solar:letter-bold" class="w-5 h-5 shrink-0 text-white" />
              hola@octavofuego.com
            </a>
          </li>
          <li>
            <a href="https://wa.me/573172137932" target="_blank" rel="noopener" class="text-[var(--color-text-on-dark)] text-sm hover:text-white transition-colors flex items-center gap-2 p-2">
              <Icon name="solar:chat-round-bold" class="w-5 h-5 shrink-0 text-white" />
              WhatsApp
            </a>
          </li>
          <li class="flex items-center gap-2 text-[var(--color-text-on-dark)] text-sm p-2">
            <Icon name="solar:map-point-bold" class="w-5 h-5 shrink-0 text-white" />
            <span>{t.footer.direccionFabrica}</span>
          </li>
          <li class="flex items-center gap-2 text-[var(--color-text-on-dark)] text-sm p-2">
            <Icon name="solar:leaf-bold" class="w-5 h-5 shrink-0 text-white" />
            <span>{t.footer.confianzaFooter}</span>
          </li>
          <li class="text-[var(--color-text-on-dark)]/70 text-xs">{t.footer.enviosZona}</li>
        </ul>

        <!-- Social Icons -->
        <div class="flex gap-4">
          <a
            href="https://instagram.com/octavofuego"
            target="_blank"
            rel="noopener"
            class="text-[var(--color-text-on-dark)] hover:text-white transition-colors p-2"
            aria-label="Ir a Instagram"
          >
            <Icon name="ph:instagram-logo-fill" class="w-6 h-6 text-white" />
          </a>
          <a
            href="https://facebook.com/octavofuego"
            target="_blank"
            rel="noopener"
            class="text-[var(--color-text-on-dark)] hover:text-white transition-colors p-2"
            aria-label="Ir a Facebook"
          >
            <Icon name="ph:facebook-logo-fill" class="w-6 h-6 text-white" />
          </a>
          <a
            href="https://wa.me/573172137932"
            target="_blank"
            rel="noopener"
            class="text-[var(--color-text-on-dark)] hover:text-white transition-colors p-2"
            aria-label="Ir a WhatsApp"
          >
            <Icon name="ph:whatsapp-logo-fill" class="w-6 h-6 text-white" />
          </a>
        </div>
      </div>
    </div>

    <!-- Bottom Bar -->
    <div class="pt-8 border-t border-white/10">
      <div class="flex flex-col md:flex-row justify-between items-center gap-4">
        <p class="text-[var(--color-text-on-dark)]/70 text-xs">
          {t.footer.copyright}
        </p>
        <div class="flex gap-6">
          <a href={localeUrl('/terminos', locale)} class="text-[var(--color-text-on-dark)]/70 text-xs hover:text-white transition-colors">
            {t.footer.terminos}
          </a>
          <a href={localeUrl('/privacidad', locale)} class="text-[var(--color-text-on-dark)]/70 text-xs hover:text-white transition-colors">
            {t.footer.privacidad}
          </a>
        </div>
      </div>
    </div>
  </div>
</footer>
