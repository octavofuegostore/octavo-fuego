---
import { useTranslations } from '@/i18n';
import type { Locale } from '@/i18n';
import { Icon } from 'astro-icon/components';

interface Props {
  locale: Locale;
  productName?: string;
}

const { locale } = Astro.props;
const t = useTranslations(locale);

interface Testimonial {
  quote: Record<string, string>;
  author: string;
  avatar?: string;
  location: Record<string, string>;
  date: string;
  rating: number;
}

const testimonials: Testimonial[] = [
  {
    quote: {
      es: "Un rapé excepcional. La pureza se siente desde el primer momento. Llegó rápido y bien empacado.",
      en: "An exceptional rapé. You can feel the purity from the first moment. It arrived fast and well packed.",
      pt: "Um rapé excepcional. A pureza se sente desde o primeiro momento. Chegou rápido e bem embalado."
    },
    author: "Mateo R.",
    location: { es: "Bogotá, Colombia", en: "Bogotá, Colombia", pt: "Bogotá, Colômbia" },
    date: "2026-06-15",
    rating: 5
  },
  {
    quote: {
      es: "Llegó rápido a Brasil. La calidad es incomparable con lo que encontraba antes. Recomendado.",
      en: "It arrived fast in Brazil. The quality is incomparable to what I found before. Recommended.",
      pt: "Chegou rápido no Brasil. A qualidade é incomparável com o que eu encontrava antes. Recomendado."
    },
    author: "Ana L.",
    location: { es: "São Paulo, Brasil", en: "São Paulo, Brazil", pt: "São Paulo, Brasil" },
    date: "2026-06-20",
    rating: 5
  },
  {
    quote: {
      es: "La conexión espiritual que buscaba. Ideal para meditación profunda y ceremonias.",
      en: "The spiritual connection I was looking for. Ideal for deep meditation and ceremonies.",
      pt: "A conexão espiritual que buscava. Ideal para meditação profunda e cerimônias."
    },
    author: "Carlos M.",
    location: { es: "Medellín, Colombia", en: "Medellín, Colombia", pt: "Medellín, Colômbia" },
    date: "2026-06-10",
    rating: 5
  }
];
---

<section class="content-visibility-auto">
  <div class="flex flex-col gap-6">
    {testimonials.map((testimonial) => (
      <div class="flex gap-4">
        <!-- Avatar -->
        <div class="flex-none">
          {testimonial.avatar ? (
            <img
              src={testimonial.avatar}
              alt={testimonial.author}
              class="w-10 h-10 rounded-full object-cover"
              loading="lazy"
            />
          ) : (
            <div class="w-10 h-10 rounded-full bg-[var(--color-action-primary)] flex items-center justify-center">
              <span class="text-sm font-bold text-white">
                {testimonial.author.charAt(0)}
              </span>
            </div>
          )}
        </div>
        <!-- Content -->
        <div class="flex-1 min-w-0">
          <!-- Stars -->
          <div class="flex gap-0.5 mb-1">
            {Array.from({ length: testimonial.rating }, (_, i) => (
              <Icon key={i} name="solar:star-bold-duotone" class="w-5 h-5 text-[var(--color-action-primary)]" />
            ))}
          </div>
          <!-- Name + Location + Date -->
          <div class="flex items-baseline gap-2 flex-wrap">
            <h3 class="text-sm font-semibold text-[var(--near-black)]">
              {testimonial.author}
            </h3>
            <span class="text-xs text-[var(--ceniza)]">
              {testimonial.location[locale]}
            </span>
            <time datetime={testimonial.date} class="text-xs text-[var(--ceniza)]/60">
              {testimonial.date}
            </time>
          </div>
          <!-- Quote -->
          <p class="text-sm text-[var(--near-black)] leading-relaxed mt-1">
            &ldquo;{testimonial.quote[locale]}&rdquo;
          </p>
        </div>
      </div>
    ))}
  </div>

  <!-- Write a Review button — opens modal -->
  <div class="flex mt-8 pt-6 border-t border-gray-100">
    <button
      id="modalButton"
      class="inline-flex items-center gap-2 px-5 py-2.5 text-sm font-medium rounded-lg transition-all duration-200 bg-[var(--color-action-primary)] text-white hover:opacity-90 active:scale-[0.98]"
    >
      <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
        <path stroke-linecap="round" stroke-linejoin="round" d="M7.5 8.25h9m-9 3H12m-9.75 1.51c0 1.6 1.123 2.994 2.707 3.227 1.129.166 2.27.293 3.423.379.35.026.67.21.865.501L12 21l2.755-4.133a1.14 1.14 0 01.865-.501 48.172 48.172 0 003.423-.379c1.584-.233 2.707-1.626 2.707-3.228V6.741c0-1.602-1.123-2.995-2.707-3.228A48.394 48.394 0 0012 3c-2.392 0-4.744.175-7.043.513C3.373 3.746 2.25 5.14 2.25 6.741v6.018z" />
      </svg>
      {locale === 'es' ? 'Escribir una reseña' : locale === 'en' ? 'Write a review' : 'Escrever uma avaliação'}
    </button>
  </div>
</section>
