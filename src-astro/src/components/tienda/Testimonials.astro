---
import type { Locale } from '@/i18n';
import { Icon } from 'astro-icon/components';

interface Props {
  locale: Locale;
  productName?: string;
}

const { locale } = Astro.props;

// No published reviews yet — show an honest empty state instead of fabricated
// testimonials. Reviews arrive via the ReviewModal → WhatsApp flow and will be
// published here once real customers share them.
const emptyState: Record<Locale, { title: string; text: string }> = {
  es: {
    title: 'Aún no hay reseñas',
    text: 'Sé el primero en escribir una reseña y comparte tu experiencia con este rapé.',
  },
  en: {
    title: 'No reviews yet',
    text: 'Be the first to write a review and share your experience with this rapé.',
  },
  pt: {
    title: 'Ainda não há avaliações',
    text: 'Seja o primeiro a escrever uma avaliação e compartilhe sua experiência com este rapé.',
  },
};

const l = emptyState[locale];
---

<section class="content-visibility-auto">
  <div class="flex flex-col gap-6">
    <!-- Empty state: honest placeholder until real reviews exist -->
    <div class="flex flex-col items-center text-center py-8 px-4 bg-[var(--color-surface-warm)] rounded-[var(--radius-card)]">
      <Icon name="solar:star-bold-duotone" class="w-8 h-8 text-[var(--color-action-primary)]/40 mb-3" />
      <p class="font-display font-semibold text-[var(--near-black)]">{l.title}</p>
      <p class="text-sm text-[var(--ceniza)] leading-relaxed max-w-sm mt-1">{l.text}</p>
    </div>
  </div>

  <!-- Write a Review button — opens ReviewModal (id="modalButton" is the modal trigger) -->
  <div class="flex mt-8 pt-6 border-t border-gray-100">
    <button
      id="modalButton"
      class="inline-flex items-center gap-2 px-5 py-2.5 text-sm font-medium rounded-lg transition-all duration-200 bg-[var(--color-action-primary)] text-white hover:opacity-90 active:scale-[0.98]"
    >
      <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
        <path stroke-linecap="round" stroke-linejoin="round" d="M7.5 8.25h9m-9 3H12m-9.75 1.51c0 1.6 1.123 2.994 2.707 3.227 1.129.166 2.27.293 3.423.379.35.026.67.21.865.501L12 21l2.755-4.133a1.14 1.14 0 01.865-.501 48.172 48.172 0 003.423-.379c1.584-.233 2.707-1.626 2.707-3.228V6.741c0-1.602-1.123-2.995-2.707-3.228A48.394 48.394 0 0012 3c-2.392 0-4.744.175-7.043.513C3.373 3.746 2.25 5.14 2.25 6.741v6.018z" />
      </svg>
      {locale === 'es' ? 'Escribir una reseña' : locale === 'en' ? 'Write a review' : 'Escrever uma avaliação'}
    </button>
  </div>
</section>
