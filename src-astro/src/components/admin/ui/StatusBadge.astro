---
export type StatusType = 'pendiente' | 'confirmada' | 'enviada' | 'entregada' | 'cancelada' | 'activo' | 'inactivo' | 'pagado' | 'fallido'

export interface Props {
  status: StatusType | string
  variant?: 'default' | 'outline'
  size?: 'sm' | 'md'
  class?: string
}

const { status, variant = 'default', size = 'sm' } = Astro.props

const colors: Record<string, { bg: string; text: string; dot: string }> = {
  pendiente: { bg: 'bg-yellow-100', text: 'text-yellow-800', dot: 'bg-yellow-500' },
  confirmada: { bg: 'bg-blue-100', text: 'text-blue-800', dot: 'bg-blue-500' },
  enviada: { bg: 'bg-purple-100', text: 'text-purple-800', dot: 'bg-purple-500' },
  entregada: { bg: 'bg-green-100', text: 'text-green-800', dot: 'bg-green-500' },
  cancelada: { bg: 'bg-red-100', text: 'text-red-800', dot: 'bg-red-500' },
  activo: { bg: 'bg-green-100', text: 'text-green-800', dot: 'bg-green-500' },
  inactivo: { bg: 'bg-gray-100', text: 'text-gray-600', dot: 'bg-gray-400' },
  pagado: { bg: 'bg-green-100', text: 'text-green-800', dot: 'bg-green-500' },
  fallido: { bg: 'bg-red-100', text: 'text-red-800', dot: 'bg-red-500' },
}

const color = colors[status] || { bg: 'bg-gray-100', text: 'text-gray-600', dot: 'bg-gray-400' }
const sizeClasses = size === 'sm' ? 'px-2 py-0.5 text-xs' : 'px-3 py-1 text-sm'
---

<span
  class:list={[
    'inline-flex items-center gap-1.5 rounded-full font-medium',
    color.bg, color.text, sizeClasses,
    Astro.props.class
  ]}
>
  <span class:list={['w-1.5 h-1.5 rounded-full', color.dot]} />
  {status}
</span>
