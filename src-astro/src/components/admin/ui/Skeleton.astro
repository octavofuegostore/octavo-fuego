---
export interface Props {
  variant?: 'text' | 'card' | 'table-row' | 'chart'
  rows?: number
  height?: string
  width?: string
  class?: string
}

const { variant = 'text', rows = 1, height, width } = Astro.props
const baseClass = 'animate-pulse bg-ceniza/10 rounded-lg'
const variants: Record<string, string> = {
  text: 'h-4 w-full',
  card: 'h-32 w-full',
  'table-row': 'h-12 w-full',
  chart: 'h-64 w-full',
}
---

<div class="space-y-3">
  {Array.from({ length: rows }).map(() => (
    <div
      class:list={[baseClass, variants[variant], Astro.props.class]}
      style={{ height, width }}
    />
  ))}
</div>
