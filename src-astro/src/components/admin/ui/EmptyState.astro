---
export interface Props {
  icon?: string  // SVG path for the icon; pas 'none' para ocultar
  title: string
  description?: string
  ctaLabel?: string  // Texto del botón (requiere ctaHref o ctaOnClick)
  ctaHref?: string   // URL si es link
  ctaOnClick?: string // JS si es botón (ej: "abrirPanelCliente()")
}

const { icon, title, description, ctaLabel, ctaHref, ctaOnClick } = Astro.props
const defaultIcon = 'M20 13V6a2 2 0 00-2-2H6a2 2 0 00-2 2v7m16 0v5a2 2 0 01-2 2H6a2 2 0 01-2-2v-5m16 0h-2.586a1 1 0 00-.707.293l-2.414 2.414a1 1 0 01-.707.293h-3.172a1 1 0 01-.707-.293l-2.414-2.414A1 1 0 006.586 13H4'
---
<div class="flex flex-col items-center justify-center py-16 px-4 text-center">
  {icon !== 'none' && (
    <svg class="w-16 h-16 text-ceniza/40 mb-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
      <path d={icon || defaultIcon} />
    </svg>
  )}
  <h3 class="text-lg font-semibold text-humo mb-1">{title}</h3>
  {description && <p class="text-sm text-ceniza max-w-sm mb-6">{description}</p>}
  {ctaLabel && (
    ctaHref ? (
      <a
        href={ctaHref}
        class="inline-flex items-center gap-2 px-4 py-2 bg-tabaco text-white rounded-lg text-sm font-medium hover:bg-tabaco/90 transition-colors"
      >
        {ctaLabel}
      </a>
    ) : ctaOnClick ? (
      <button
        onclick={ctaOnClick}
        class="inline-flex items-center gap-2 px-4 py-2 bg-tabaco text-white rounded-lg text-sm font-medium hover:bg-tabaco/90 transition-colors"
      >
        {ctaLabel}
      </button>
    ) : null
  )}
</div>
