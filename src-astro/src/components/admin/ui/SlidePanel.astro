---
export interface Props {
  id: string           // unique panel ID
  title: string
  open?: boolean       // controlled by parent or URL
  size?: 'sm' | 'md' | 'lg'
  class?: string
}

const { id, title, open = false, size = 'md' } = Astro.props
const sizeClasses = { sm: 'max-w-md', md: 'max-w-lg', lg: 'max-w-2xl' }
---

<div
  id={`panel-${id}`}
  class:list={[
    'fixed inset-y-0 right-0 z-50 w-full bg-white shadow-xl transform transition-transform duration-300',
    sizeClasses[size],
    open ? 'translate-x-0' : 'translate-x-full'
  ]}
  role="dialog"
  aria-modal="true"
  aria-labelledby={`panel-${id}-title`}
>
  <div class="flex items-center justify-between p-4 border-b border-papel">
    <h2 id={`panel-${id}-title`} class="text-lg font-display font-bold text-humo">{title}</h2>
    <button
      id={`panel-${id}-close`}
      class="p-2 rounded-lg hover:bg-papel/50 transition-colors text-ceniza hover:text-humo"
      aria-label="Cerrar"
    >
      <svg class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <path d="M18 6L6 18M6 6l12 12" />
      </svg>
    </button>
  </div>
  <div class="p-4 overflow-y-auto max-h-[calc(100vh-4rem)]">
    <slot />
  </div>
</div>

<script define:vars={{ id }}>
  const panel = document.getElementById(`panel-${id}`);
  const closeBtn = document.getElementById(`panel-${id}-close`);
  const backdrop = document.getElementById(`panel-${id}-backdrop`);

  function getFocusableElements() {
    if (!panel) return [];
    return Array.from(
      panel.querySelectorAll(
        'a[href], button:not([disabled]), textarea:not([disabled]), input:not([disabled]), select:not([disabled]), [tabindex]:not([tabindex="-1"])',
      ),
    );
  }

  function focusFirstElement() {
    const focusable = getFocusableElements();
    if (focusable.length > 0) {
      (focusable[0] as HTMLElement).focus();
    } else {
      panel?.focus();
    }
  }

  function handleKeyDown(e: KeyboardEvent) {
    if (e.key === 'Escape') {
      closeBtn?.click();
      return;
    }

    if (e.key !== 'Tab') return;

    const focusable = getFocusableElements();
    if (focusable.length === 0) {
      e.preventDefault();
      return;
    }

    const first = focusable[0] as HTMLElement;
    const last = focusable[focusable.length - 1] as HTMLElement;

    if (e.shiftKey) {
      if (document.activeElement === first) {
        e.preventDefault();
        last.focus();
      }
    } else {
      if (document.activeElement === last) {
        e.preventDefault();
        first.focus();
      }
    }
  }

  // Observe when panel opens/closes via class changes
  const observer = new MutationObserver(() => {
    const isOpen = panel?.classList.contains('translate-x-0');
    if (isOpen) {
      focusFirstElement();
      document.addEventListener('keydown', handleKeyDown);
    } else {
      document.removeEventListener('keydown', handleKeyDown);
    }
  });

  if (panel) {
    panel.setAttribute('tabindex', '-1');
    observer.observe(panel, { attributes: true, attributeFilter: ['class'] });
    // If already open on page load
    if (panel.classList.contains('translate-x-0')) {
      focusFirstElement();
      document.addEventListener('keydown', handleKeyDown);
    }
  }

  // Close on backdrop click
  backdrop?.addEventListener('click', () => {
    closeBtn?.click();
  });
</script>

<!-- Backdrop -->
<div
  id={`panel-${id}-backdrop`}
  class:list={[
    'fixed inset-0 bg-black/30 z-40 transition-opacity duration-300',
    open ? 'opacity-100' : 'opacity-0 pointer-events-none'
  ]}
/>
