---
import { useTranslations, languageNames } from '@/i18n';
import type { Locale } from '@/i18n';
import { getLocaleUrl } from '@/i18n/links';
import { Icon } from 'astro-icon/components';

interface Props {
  locale?: Locale;
}

const { locale = 'es' } = Astro.props;
const t = useTranslations(locale);

const locales: Locale[] = ['es', 'en', 'pt'];
const currentUrl = Astro.url.pathname;
---

<div class="relative" id="language-switcher">
  <button
    id="lang-switcher-btn"
    class="flex items-center gap-1 text-sm font-medium text-[var(--ceniza)] hover:text-[var(--near-black)] transition-colors px-2 py-1 rounded-md hover:bg-gray-50"
    aria-expanded="false"
    aria-haspopup="true"
    aria-controls="lang-switcher-menu"
    aria-label="Idioma"
  >
<Icon name="solar:global-bold-duotone" class="w-4 h-4" />
    <span class="hidden sm:inline">{languageNames[locale]}</span>
    <Icon name="solar:alt-arrow-down-bold-duotone" class="w-3 h-3 transition-transform" id="lang-switcher-arrow" />
  </button>

  <div
    id="lang-switcher-menu"
    role="menu"
    aria-label="Seleccionar idioma"
    class="absolute top-full right-0 pt-2 opacity-0 invisible transition-all duration-200"
  >
    <div class="bg-white border border-gray-200 shadow-[var(--shadow-hover)] py-1 min-w-[120px] rounded-[var(--radius-card)]">
      {locales.map((loc) => (
        <a
          href={getLocaleUrl(loc, currentUrl)}
          role="menuitem"
          class={`block px-4 py-2 text-sm transition-colors ${
            loc === locale
              ? 'text-[var(--color-action-primary)] font-semibold bg-gray-50'
              : 'text-[var(--ceniza)] hover:text-[var(--near-black)] hover:bg-gray-50'
          }`}
        >
          {languageNames[loc]}
        </a>
      ))}
    </div>
  </div>
</div>

<script>
  document.addEventListener('astro:page-load', () => {
    const wrapper = document.getElementById('language-switcher');
    const btn = document.getElementById('lang-switcher-btn');
    const menu = document.getElementById('lang-switcher-menu');
    const arrow = document.getElementById('lang-switcher-arrow');

    if (!wrapper || !btn || !menu) return;

    const items = Array.from(menu.querySelectorAll('[role="menuitem"]'));

    function openMenu() {
      menu.classList.remove('opacity-0', 'invisible');
      menu.classList.add('opacity-100', 'visible');
      btn?.setAttribute('aria-expanded', 'true');
      if (arrow) arrow.classList.add('rotate-180');
    }

    function closeMenu() {
      menu.classList.add('opacity-0', 'invisible');
      menu.classList.remove('opacity-100', 'visible');
      btn?.setAttribute('aria-expanded', 'false');
      if (arrow) arrow.classList.remove('rotate-180');
    }

    function isOpen() {
      return !menu.classList.contains('invisible');
    }

    // Hover support
    wrapper.addEventListener('mouseenter', openMenu);
    wrapper.addEventListener('mouseleave', closeMenu);

    // Keyboard: Enter/Space toggle
    btn.addEventListener('keydown', (e) => {
      if (e.key === 'Enter' || e.key === ' ') {
        e.preventDefault();
        if (isOpen()) {
          closeMenu();
        } else {
          openMenu();
          // Focus first item
          const firstItem = items[0] as HTMLElement | undefined;
          firstItem?.focus();
        }
      }
      if (e.key === 'ArrowDown' && isOpen()) {
        e.preventDefault();
        const firstItem = items[0] as HTMLElement | undefined;
        firstItem?.focus();
      }
      if (e.key === 'ArrowUp' && isOpen()) {
        e.preventDefault();
        const lastItem = items[items.length - 1] as HTMLElement | undefined;
        lastItem?.focus();
      }
      if (e.key === 'Escape' && isOpen()) {
        e.preventDefault();
        closeMenu();
        btn?.focus();
      }
    });

    // Keyboard: Arrow keys within menu items
    items.forEach((item, index) => {
      item.addEventListener('keydown', (e) => {
        if (e.key === 'ArrowDown') {
          e.preventDefault();
          const next = items[index + 1] ?? items[0];
          (next as HTMLElement).focus();
        }
        if (e.key === 'ArrowUp') {
          e.preventDefault();
          const prev = items[index - 1] ?? items[items.length - 1];
          (prev as HTMLElement).focus();
        }
        if (e.key === 'Escape') {
          e.preventDefault();
          closeMenu();
          btn?.focus();
        }
      });
    });

    // Close on click outside
    document.addEventListener('click', (e) => {
      if (isOpen() && !wrapper.contains(e.target as Node)) {
        closeMenu();
      }
    });
  });
</script>
