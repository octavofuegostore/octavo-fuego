---
import { useTranslations, type Locale } from '@/i18n';
import { products } from '@/data/products';

interface Props {
  currentSlug: string;
  locale: Locale;
  baseUrl: string;
}

const { currentSlug, locale, baseUrl } = Astro.props;
const t = useTranslations(locale);

const related = products
  .filter(p => p.slug !== currentSlug)
  .sort((a, b) => a.varietyOrder - b.varietyOrder)
  .slice(0, 4);
---

<section class="mt-16 pt-8 border-t border-[var(--color-border-subtle)]">
  <h2 class="text-sm font-semibold uppercase tracking-widest text-[var(--ceniza)] mb-6">
    {t.product.productosRelacionados}
  </h2>
  <div class="grid grid-cols-2 lg:grid-cols-4 gap-4">
    {related.map(p => (
      <a
        href={`${baseUrl}/tienda/rape/${p.slug}`}
        class="group block bg-[var(--papel)] rounded-[var(--radius-card)] p-5"
      >
        <div class="aspect-square overflow-hidden rounded-lg mb-3">
          <img
            src={p.imagenes[0]}
            alt={"Imagen de " + p.nombre[locale]}
            class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
            width="600"
            height="600"
            loading="lazy"
          />
        </div>
        <p class="text-base font-display font-bold text-[var(--near-black)] group-hover:text-[var(--color-action-primary)] transition-colors duration-300">
          {p.nombre[locale]}
        </p>
        <p class="text-xs text-[var(--ceniza)] leading-snug mt-1">
          {p.overview[locale].split('.')[0].substring(0, 120)}.
        </p>
        <p class="text-sm text-[var(--color-action-primary)] font-semibold mt-2">
          {p.pricing[1]?.label ?? p.pricing[0]?.label} — ${new Intl.NumberFormat('es-CO').format(p.pricing[1]?.precio ?? p.pricing[0]?.precio)} COP
        </p>
      </a>
    ))}
  </div>
</section>
