---
import { useTranslations, type Locale } from '@/i18n';
import { products } from '@/data/products';

interface Props {
  currentSlug: string;
  locale: Locale;
  baseUrl: string;
}

const { currentSlug, locale, baseUrl } = Astro.props;
const t = useTranslations(locale);

const related = products
  .filter(p => p.slug !== currentSlug)
  .sort((a, b) => a.varietyOrder - b.varietyOrder)
  .slice(0, 4);
---

<section class="mt-16 pt-8 border-t border-[var(--color-border-subtle)]">
  <h2 class="text-sm font-semibold uppercase tracking-widest text-[var(--ceniza)] mb-6">
    {t.product.productosRelacionados}
  </h2>
  <div class="grid grid-cols-2 lg:grid-cols-4 gap-4">
    {related.map(p => (
      <a
        href={`${baseUrl}/tienda/rape/${p.slug}`}
        class="group block"
      >
        <div class="aspect-square bg-[var(--papel)] rounded-[var(--radius-card)] overflow-hidden mb-3 transition-shadow duration-300 group-hover:shadow-[var(--shadow-hover)]">
          <img
            src={p.imagenes[0]}
            alt={p.nombre[locale]}
            class="w-full h-full object-cover"
            width="400"
            height="400"
            loading="lazy"
          />
        </div>
        <p class="text-sm font-display font-bold text-[var(--near-black)] group-hover:text-[var(--color-action-primary)] transition-colors duration-300">
          {p.nombre[locale]}
        </p>
        <p class="text-xs text-[var(--color-action-primary)] font-semibold mt-1">
          {p.pricing[1]?.label ?? p.pricing[0]?.label} — ${new Intl.NumberFormat('es-CO').format(p.pricing[1]?.precio ?? p.pricing[0]?.precio)} COP
        </p>
      </a>
    ))}
  </div>
</section>
