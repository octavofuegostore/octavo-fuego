---
/**
 * GraphSchema — @graph JSON-LD for the homepage
 *
 * Combines WebPage, WebSite, and ItemList in a single
 * <script type="application/ld+json"> block.
 * Does NOT include Organization — Layout.astro already renders OrganizationJsonLd
 * with @id: 'https://octavofuego.com/#organization' which is referenced here.
 */
import type { Locale } from '@/i18n';
import { localeUrl } from '@/i18n/links';

export interface Props {
  locale?: Locale;
}

const { locale = 'es' } = Astro.props;

const BASE = 'https://octavofuego.com';

const pageName = locale === 'es' ? 'Inicio' : locale === 'en' ? 'Home' : 'Início';
const pageDescription =
  locale === 'es'
    ? 'Rapé do Acre directo desde Brasil — el mejor precio por gramo de Colombia'
    : locale === 'en'
      ? 'Rapé do Acre direct from Brazil — the best price per gram'
      : 'Rapé do Acre direto do Brasil — o melhor preço por grama';

const itemListName =
  locale === 'es'
    ? 'Rapé do Acre — listado completo'
    : locale === 'en'
      ? 'Rapé do Acre — complete list'
      : 'Rapé do Acre — lista completa';

const productSlugs = ['tsunu', 'pixuri', 'parika', 'cumaru-de-cheiro', 'vena-de-paje'];
const productNames = ['Tsunú', 'Pixurí', 'Pariká', 'Cumarú de Cheiro', 'Vena de Pajé'];

const productList = productSlugs.map((slug, i) => ({
  position: i + 1,
  url: `${BASE}${localeUrl('/tienda/rape/' + slug, locale)}`,
  name: productNames[i],
}));

const schema = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'WebPage',
      '@id': `${BASE}/#webpage`,
      url: BASE,
      name: `Octavo Fuego — ${pageName}`,
      description: pageDescription,
      isPartOf: {
        '@id': `${BASE}/#website`,
      },
      about: {
        '@id': `${BASE}/#organization`,
      },
    },
    {
      '@type': 'WebSite',
      '@id': `${BASE}/#website`,
      url: BASE,
      name: 'Octavo Fuego',
      description: 'Rapé do Acre, Sananga y Kuripes. Medicinas ancestrales amazónicas con propósito.',
      publisher: {
        '@id': `${BASE}/#organization`,
      },
    },
    {
      '@type': 'ItemList',
      '@id': `${BASE}/#homepage-products`,
      name: itemListName,
      numberOfItems: productList.length,
      itemListElement: productList.map((p) => ({
        '@type': 'ListItem',
        position: p.position,
        url: p.url,
        name: p.name,
      })),
    },
  ],
};
---

<script type="application/ld+json" set:html={JSON.stringify(schema)} />
