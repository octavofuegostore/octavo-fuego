---
export interface Props {
  /** Full name of the person */
  name: string;
  /** Job title (e.g. "Founder & Guía Espiritual") */
  jobTitle?: string;
  /** Personal or profile URL */
  url?: string;
  /** Social profile URLs (Instagram, Pinterest, YouTube, etc.) */
  sameAs?: string[];
}

const { name, jobTitle, url, sameAs } = Astro.props;

const schema = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  '@id': 'https://octavofuego.com/#person',
  name,
  affiliation: {
    '@type': 'Organization',
    '@id': 'https://octavofuego.com/#organization',
  },
  ...(jobTitle && { jobTitle }),
  ...(url && { url }),
  ...(sameAs && sameAs.length > 0 && { sameAs }),
};
---
<script type="application/ld+json" set:html={JSON.stringify(schema)} />
