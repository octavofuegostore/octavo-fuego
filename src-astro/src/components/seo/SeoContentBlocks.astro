---
/**
 * SeoContentBlocks — In-page SEO content sections for Product Detail Pages
 *
 * Three blocks rendered between the overview paragraph and the PricingTable:
 *   1. AI Summary Nugget — max 200 chars, pure factual summary
 *   2. Prove-It — 2+ hard facts (origin, tradition, format, preparation)
 *   3. Not For You — honest bad-fit scenarios
 *
 * All content is locale-aware via product data + curated copy.
 */

import type { Locale } from '@/i18n';
import type { Product } from '@/data/products';

interface Props {
  locale: Locale;
  product: Product;
}

const { locale, product } = Astro.props;

// ─── Locale-aware section labels ─────────────────────────────────────────

const labels = {
  aiSummary: {
    es: 'En síntesis',
    en: 'In a Nutshell',
    pt: 'Em síntese',
  },
  proveIt: {
    es: 'Datos clave',
    en: 'Facts & Figures',
    pt: 'Dados importantes',
  },
  notForYou: {
    es: 'Este rapé no es para ti si…',
    en: 'This rapé is not for you if…',
    pt: 'Este rapé não é para você se…',
  },
} as const;

// ─── AI Summary Nugget — max 200 chars per locale ────────────────────────

const summaries: Record<string, Record<Locale, string>> = {
