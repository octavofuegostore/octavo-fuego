const summary = summaries[product.slug]?.[locale] ?? '';
const facts = proveItData[product.slug]?.[locale] ?? [];
const notForYouItems = notForYouData[product.slug]?.[locale] ?? [];
---

<section class="seo-content-blocks space-y-8 my-8">
  <!-- Block 1: AI Summary Nugget -->
  {summary && (
    <div class="ai-summary rounded-xl bg-[var(--color-action-primary)]/5 border border-[var(--color-action-primary)]/10 p-5">
      <p class="text-[0.65rem] uppercase tracking-[0.15em] font-bold text-[var(--color-action-primary)] mb-2">
        {labels.aiSummary[locale]}
      </p>
      <p class="text-sm text-[var(--near-black)] leading-relaxed">
        {summary}
      </p>
    </div>
  )}

  <!-- Block 2: Prove-It — hard facts -->
  {facts.length > 0 && (
    <div class="prove-it">
      <p class="text-[0.65rem] uppercase tracking-[0.15em] font-bold text-[var(--color-action-primary)] mb-3">
        {labels.proveIt[locale]}
      </p>
      <ul class="space-y-2">
        {facts.slice(0, 3).map(({ fact }) => (
          <li class="flex items-start gap-2 text-sm text-[var(--near-black)] leading-relaxed">
            <span class="mt-1.5 w-1.5 h-1.5 rounded-full bg-[var(--color-action-primary)] shrink-0" aria-hidden="true" />
            <span>{fact}</span>
          </li>
        ))}
      </ul>
    </div>
  )}

  <!-- Block 3: Not For You — honest bad-fit -->
  {notForYouItems.length > 0 && (
    <div class="not-for-you rounded-xl bg-[var(--humo)] p-5">
      <p class="text-[0.65rem] uppercase tracking-[0.15em] font-bold text-[var(--papel)] mb-2">
        {labels.notForYou[locale]}
      </p>
      <ul class="space-y-1.5">
        {notForYouItems.map((item) => (
          <li class="flex items-start gap-2 text-sm text-[var(--papel)] leading-relaxed">
            <span class="mt-1.5 w-1.5 h-1.5 rounded-full bg-[var(--color-action-primary)] shrink-0" aria-hidden="true" />
            <span>{item}</span>
          </li>
        ))}
      </ul>
    </div>
  )}
</section>
