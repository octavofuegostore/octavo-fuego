    en: [
      { fact: 'Ash from the "tree that does not rot" — uses the entire tree, not just the bark', source: 'descripcion' },
      { fact: 'Contains coumarin with anticoagulant, antispasmodic, and bronchodilator properties', source: 'descripcion' },
      { fact: 'Incorporates imburana seeds into its formula', source: 'descripcion' },
      { fact: 'Medium-high intensity, sweet and woody aroma — intermediate level', source: 'intensidad' },
    ],
    pt: [
      { fact: 'Cinza da "árvore que não apodrece" — usada a árvore completa', source: 'descripcion' },
      { fact: 'Contém cumarina com propriedades anticoagulantes e broncodilatadoras', source: 'descripcion' },
      { fact: 'Incorpora sementes de imburana em sua fórmula', source: 'descripcion' },
