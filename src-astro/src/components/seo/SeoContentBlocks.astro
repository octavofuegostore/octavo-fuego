// ─── Not For You — honest bad-fit scenarios per product ──────────────────

const notForYouData: Record<string, Record<Locale, string[]>> = {
  tsunu: {
    es: ['Buscas un rapé suave para uso diario', 'recién comienzas con rapés ceremoniales', 'prefieres experiencias sutiles y livianas'],
    en: ['you are looking for a mild rapé for daily use', 'you are just starting with ceremonial rapés', 'you prefer subtle, light experiences'],
    pt: ['você busca um rapé suave para uso diário', 'você está começando com rapés cerimoniais', 'prefere experiências sutis e leves'],
  },
  pixuri: {
    es: ['Tu enfoque principal es espiritual/ceremonial intenso', 'buscas una experiencia energética fuerte', 'prefieres rapés de nivel avanzado'],
    en: ['your main focus is intense spiritual/ceremonial work', 'you are looking for a strong energetic experience', 'you prefer advanced-level rapés'],
    pt: ['seu foco principal é trabalho espiritual/cerimonial intenso', 'você busca uma experiência energética forte', 'prefere rapés de nível avançado'],
  },
  parika: {
    es: ['Buscas un rapé con enfoque medicinal o físico', 'prefieres propiedades respiratorias o analgésicas', 'no trabajas con ceremonias espirituales profundas'],
    en: ['you are looking for a medicinal or physical rapé', 'you prefer respiratory or analgesic properties', 'you do not work with deep spiritual ceremonies'],
    pt: ['você busca um rapé com foco medicinal ou físico', 'prefere propriedades respiratórias ou analgésicas', 'não trabalha com cerimônias espirituais profundas'],
  },
  'cumaru-de-cheiro': {
    es: ['Tomas anticoagulantes (consultar con profesional de salud por la cumarina)', 'buscas un rapé exclusivamente espiritual o exclusivamente físico', 'prefieres intensidad suave'],
    en: ['you take anticoagulant medication (consult a health professional for coumarin content)', 'you are looking for an exclusively spiritual or exclusively physical rapé', 'you prefer soft intensity'],
    pt: ['você toma anticoagulantes (consultar profissional de saúde pela cumarina)', 'busca um rapé exclusivamente espiritual ou exclusivamente físico', 'prefere intensidade suave'],
  },
  'vena-de-paje': {
    es: ['Buscas un rapé de una sola tradición tabacalera', 'prefieres perfiles de aroma suaves o dulces', 'tu práctica no incluye meditación o trabajo con la glándula pineal'],
    en: ['you are looking for a single-tobacco rapé', 'you prefer mild or sweet aroma profiles', 'your practice does not include meditation or pineal gland work'],
