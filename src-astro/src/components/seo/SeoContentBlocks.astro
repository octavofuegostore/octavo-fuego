    ],
    pt: [
      { fact: 'Apenas dois ingredientes: cinza de Pariká e tabaco de corda', source: 'descripcion' },
      { fact: 'Tradição do povo Kaxinawá da Amazônia brasileira', source: 'descripcion' },
      { fact: 'Alta intensidade — nível cerimonial, atua no plano espiritual', source: 'intensidad' },
      { fact: 'Conhecido também como "Pereira" nas selvas do Brasil', source: 'descripcion' },
    ],
  },
  'cumaru-de-cheiro': {
