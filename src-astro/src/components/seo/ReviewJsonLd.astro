---
/**
 * ReviewJsonLd — Schema.org Review + AggregateRating structured data.
 * Uses hardcoded testimonials to provide review markup for product pages.
 * Enables star ratings in Google Search rich snippets.
 */

interface Review {
  quote: Record<string, string>;
  author: string;
  location: Record<string, string>;
  date: string;
  rating: number;
}

interface Props {
  locale: string;
  productName: string;
  productUrl: string;
  productId: string;
}

const { locale, productName, productUrl, productId } = Astro.props;

// Shared testimonials that apply to any product
const reviews: Review[] = [
  {
    quote: {
      es: "Un rapé excepcional. La pureza se siente desde el primer momento.",
      en: "An exceptional rapé. You can feel the purity from the first moment.",
      pt: "Um rapé excepcional. A pureza se sente desde o primeiro momento."
    },
    author: "Mateo R.",
    location: { es: "Bogotá, Colombia", en: "Bogotá, Colombia", pt: "Bogotá, Colômbia" },
    date: "2026-06-15",
    rating: 5
  },
  {
    quote: {
      es: "Llegó rápido a Brasil. La calidad es incomparable.",
      en: "It arrived fast in Brazil. The quality is incomparable.",
      pt: "Chegou rápido no Brasil. A qualidade é incomparável."
    },
    author: "Ana L.",
    location: { es: "São Paulo, Brasil", en: "São Paulo, Brazil", pt: "São Paulo, Brasil" },
    date: "2026-06-20",
    rating: 5
  },
  {
    quote: {
      es: "Perfecto para meditación profunda y ceremonias.",
      en: "Perfect for deep meditation and ceremonies.",
      pt: "Perfeito para meditação profunda e cerimônias."
    },
    author: "Carlos M.",
    location: { es: "Medellín, Colombia", en: "Medellín, Colombia", pt: "Medellín, Colômbia" },
    date: "2026-06-10",
    rating: 5
  }
];

const localeReviews = reviews.map((r) => ({
  ...r,
  quote: r.quote[locale] || r.quote.es,
  location: r.location[locale] || r.location.es,
}));

const avgRating = localeReviews.reduce((sum, r) => sum + r.rating, 0) / localeReviews.length;
const bestRating = 5;
const worstRating = 1;

const escape = (s: string) =>
  s.replace(/\\/g, '\\\\').replace(/"/g, '\\"').replace(/\n/g, '\\n');
---

<script type="application/ld+json" set:html={JSON.stringify({
  "@context": "https://schema.org",
  "@type": "Product",
  "@id": `${productUrl}#product`,
  "name": productName,
  "url": productUrl,
  "aggregateRating": {
    "@type": "AggregateRating",
    "ratingValue": avgRating.toFixed(1),
    "bestRating": bestRating,
    "worstRating": worstRating,
    "ratingCount": reviews.length,
    "reviewCount": reviews.length
  },
  "review": localeReviews.map((r) => ({
    "@type": "Review",
    "reviewRating": {
      "@type": "Rating",
      "ratingValue": r.rating,
      "bestRating": bestRating,
      "worstRating": worstRating
    },
    "author": {
      "@type": "Person",
      "name": r.author
    },
    "datePublished": r.date,
    "reviewBody": r.quote
  }))
}, null, 0)} />
